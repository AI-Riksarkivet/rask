model
  schema 1.1

# Lance catalog authorization model — multi-tenant ReBAC (OpenFGA / Zanzibar).
#
# Hierarchy:  team -> project -> warehouse(= one S3 bucket) -> namespace (self-nesting) -> table
#   the estate's containment rule end to end, with lance's
#   concentric-rung style (owner > writer > reader) layered on top, plus a `validator` rung.
#   `materialized_view` and `transaction` hang off namespace/warehouse and inherit the SAME rungs via
#   `parent`, so a grant on the enclosing stage reaches the views + transactions inside it.
# Privileges: concentric rungs cascade DOWN via `parent` / `project`. A SEPARATE `validator` rung gates
#   medallion stage PROMOTION (e.g. silver -> gold): a plain writer can write within a stage but cannot
#   promote INTO a gated stage; only an owner or an explicit validator can (`can_promote: validator`).
# Multi-tenancy: a team owns a project (members inherit project admin); a team can own MANY projects;
#   each project has exactly ONE warehouse (bucket). Projects are isolated — a grant on project A's
#   warehouse never reaches project B.
# Permissions: every API operation is checked against a `can_*` ACTION relation (the model, not the app,
#   owns the op->privilege mapping). Roles (`role#assignee`) are first-class subjects on every rung, so a
#   grant can target a persona, not just a single user. Teams (`team#member`) flow in INDIRECTLY — a team
#   can be assigned to a role or made a project member; the resource rungs deliberately do NOT accept
#   `team#member` directly (grant a role to the team instead), keeping team access auditable via roles.
#
# CREATE-ON-PARENT COVERAGE (audited 2026-08-08 against the openfga skill's checklist: every parent->child
#   pair either has a `can_create_<child>` door on the parent, or documents why it does not). Two pairs
#   answer "documented" rather than "door", and both answers are deliberate — recorded so the next auditor
#   running the same checklist does not re-file them as gaps:
#     project   -> warehouse / annotation_project   `can_create_warehouse` / `can_create_annotation_project`
#     warehouse -> namespace / table / mat.view     `can_create_namespace` / `_table` / `_materialized_view`
#     namespace -> namespace / table / mat.view     same three, so a nested create is gated by its enclosing stage
#     team      -> project                          NO `can_create_project`, ON PURPOSE: minting a TENANT is an
#         estate-admin operation, not a team one. `POST /v1/projects` gates on `can_observe_events` on the
#         ROOT object (services/catalog/.../projects.py) — the same owner-tier door the estate-wide feed
#         uses — and then seeds the creator's `admin` tuple. A `can_create_project` on `team` would let a
#         team lead mint tenants, which is a different (and larger) product decision than it looks.
#     namespace/warehouse -> transaction            NO `can_create_transaction`, because NO API CREATES ONE:
#         the catalog exposes only `/v1/transaction/{id}/describe` and `/alter`; transaction objects are
#         minted by the backend as part of ops that are already gated. Creation is therefore enforced
#         outside OpenFGA by construction. If a create endpoint is ever added, this line is the reminder
#         that it needs a door on `namespace` AND `warehouse` (both are allowed parents).

type user

# A team — a group of users. `team:eng#member` is usable anywhere a [user] subject is.
type team
  relations
    define member: [user]

# An assignable role (persona): `role:validators#assignee` is a first-class subject. Members can be
# users, whole teams, or other roles (nesting).
type role
  relations
    # THE TENANT THIS ROLE BELONGS TO. Without it a role name is estate-global, so `role:analyst` minted
    # in one project can be granted a rung on another project's namespace and the model cannot tell.
    # Optional by construction: a role carrying no project is estate-wide and keeps its existing reach,
    # so adding the edge grants nothing and takes nothing away until a role is scoped.
    define project: [project]
    define assignee: [user, team#member, role#assignee]

# A project = a tenant. Owned by a team (members become admins). Holds one warehouse.
type project
  relations
    define team: [team]
    define admin: [user, role#assignee] or member from team
    define member: [user, team#member, role#assignee] or admin
    # ---- the admin SPLIT. Additive: `admin` implies all three, so nobody loses a rung by their
    # arrival, and each exists to be granted WITHOUT the other two.
    # Security work (grants, ownership) without the power to read or change the data it governs.
    define security_admin: [user, role#assignee] or admin
    # Warehouse/data work without the power to hand out access to it.
    define data_admin: [user, role#assignee] or admin
    # Minting a role is not the same authority as deciding who is IN one, so this sits under
    # security_admin rather than beside it.
    define role_creator: [user, role#assignee] or security_admin
    # ---- actions ----
    define can_administer: admin
    define can_create_warehouse: admin
    # Create-on-parent for annotation projects: the child object does not exist yet, so the door is
    # the TENANT. `member`, not `admin` — labeling is ordinary tenant work, and the creator becomes
    # the new project's owner via seed_ownership.
    define can_create_annotation_project: member
    # ---- membership grants (P6) ----
    # Until these existed the tenant had no door of its own: `admin`/`member` were writable only by
    # the create-time seed and the estate-gated raw tuple editor, so the person who created a project
    # — and holds `admin` on it — could not invite anyone into it. The model already said
    # `can_administer: admin` was the right authority; there was simply no endpoint behind it.
    #
    # ADMIN IS GRANTABLE BY AN ADMIN, deliberately. The alternative (members only, admin-minting kept
    # at the estate) reads safer and is not: a project admin is already `warehouse#owner` via
    # `admin from project`, so they can hand out `owner` on any namespace or table beneath — full data
    # power, permanently, and re-delegable. Withholding `admin` would withhold the audit-legible path
    # and leave the powerful one open. It also matches Lakekeeper, whose `can_grant_project_admin` is
    # `project_admin`, and whose comment names the reason this is safe: the API refuses to remove the
    # LAST admin, so a tenant can self-govern without being able to strand itself.
    define can_grant_admin: admin
    define can_grant_member: admin
    # Seeing who holds what follows from being able to change it — the same derivation as the data
    # rungs' `can_read_assignments`, so a rung added here cannot leave the read behind.
    define can_read_assignments: admin

# A warehouse = exactly one S3 bucket, owned by one project. The catalog root object is a `warehouse:`.
# Concentric rungs inherit from the project (admins own; members read).
type estate
    relations
        # THE ESTATE ROOT ([[LH-055]], owner ruling docs/DECISIONS.md:2240 — "the FGA model shape is a
        # PORT"). The reference model calls it `type server` with `define project: [project]` beneath
        # it; the name here says what it IS in this estate rather than what it is in a web service.
        #
        # `fga_root_object` NAMES THIS TYPE, and only this one. The structural root a top-level
        # namespace hangs off is a SEPARATE setting (`fga_default_warehouse_object`,
        # `warehouse:lance_catalog`) because `namespace#parent` is typed `[warehouse, namespace]` and
        # inherits eight rungs `… from parent` that this type does not define — pointing a namespace
        # here is a model error and a lost cascade. The two are held apart by
        # `tests/unit/test_the_two_fga_roots_answer_two_different_questions.py`.
        #
        # WHAT A SEPARATE TYPE BUYS over a second warehouse: `can_browse_storage` on `warehouse`
        # resolves on ANY warehouse its owner owns, so the privilege was estate-scoped only because
        # every call site remembered to name the root. A tenant cannot own an `estate:` object, so the
        # scope is the model's now. Pinned in `model.fga.yaml` as alice holding nothing here.
        #
        # NO DOWNWARD `project: [project]`, though the reference model declares one under its `server`.
        # Nothing here would traverse it — `can_create_project` is `admin or operator`, not
        # `... from project` — so it would be a relation carried because the precedent has it. It is
        # also not free: a project object in the USER position is invisible to `revoke_object_tuples`,
        # which reads BY OBJECT, so deleting a project would strand `estate:X#project@project:Y` with
        # no lifecycle answering for it. `test_no_new_object_as_user_shape_slips_past_revoke` refuses
        # exactly that, and it refused this. Add the edge when a rule needs to traverse it, with the
        # cleanup decided in the same change.
        define admin: [user, role#assignee]
        # A machine identity is a RELATION on the top type, never a principal type — the ruling is
        # explicit, and `type user` carries no relations for the same reason.
        define operator: [user, role#assignee] or admin
        # THE TIERS THREE SERVICES ALREADY GATE WHOLE ROUTERS ON. `compute/security.py:39` and
        # `controlplane/security.py:42` check `reader` on the root object; `flows/security.py:18`
        # checks `writer` there, "not a can_* verb", and relies on `writer: ... or owner` to pass the
        # bootstrap owner. A root type without these refuses all three the day it is repointed.
        define owner: [user, role#assignee] or admin
        define writer: [user, role#assignee] or owner
        define reader: [user, role#assignee] or writer
        # `can_stage_events` is NOT a pure computed userset over `owner` the way its two neighbours
        # are, so it carries its own grantable relation and does not migrate like them.
        define event_stager: [user, role#assignee]
        define can_create_project: admin or operator
        # THE ESTATE-ADMIN RUNG. Checked ONLY on the root object (`fga_root_object`), never on a
        # caller-supplied one, so there is nothing to inject. Owner-tier: authz scope == data scope, and
        # a per-project admin must not reach an estate-wide surface.
        #
        # **THE NAME UNDERSTATES IT, AND THAT IS THE THING TO KNOW BEFORE GRANTING IT** — "grant this
        # and someone can watch a feed" is what it reads like, and it is not what it does. Measured
        # across the estate 2026-09-15, holding it also grants:
        #   * `GET /v1/events` — every project's governance changes (`endpoints/events.py:59`)
        #   * `POST /v1/projects` + the project list/get — i.e. CREATING TENANTS (`endpoints/projects.py:184,246`)
        #   * the raw-tuple admin route — reading and MUTATING the authorization graph itself
        #     (`endpoints/access_admin.py:199`)
        #   * `POST /v1/stores` and its attach/detach siblings — naming a host the estate will talk to
        #     (`endpoints/stores.py:105,135,197`)
        #   * lineage's whole-estate projection (`api/fga_deps.py:144` in services/lineage)
        #   * the `estate_admin` flag `/v1/me` reports (`endpoints/me.py:62`) — a display lookup rather
        #     than a door, listed because it is a consumer and the gate below derives its list from code
        # The viewer and controlplane gate their own estate reads on their own relations and merely CITE
        # this one for contrast, so they are deliberately absent.
        # So this is not an observer rung wearing an admin's name — it IS the admin rung, and "observe"
        # is the weakest thing it permits. Renaming it is [[LH-076]]'s other half and needs an owner
        # call, because the string appears in seeded tuples; correcting what it CLAIMS needs nobody's.
        #
        # Pinned by `tests/unit/test_the_estate_rung_documents_everything_it_gates.py`, which derives
        # the consumer list from the code rather than trusting this comment — the drift it closes is
        # exactly the one that produced the understated text.
        define can_observe_events: owner
        # Raw OBJECT-STORE browsing (#90) — the viewer's `/api/objects`, `/api/object`,
        # `/api/object/download`: an S3 list, a HEAD, and a full byte download over any bucket in the
        # store registry. Like can_observe_events this is an ESTATE-WIDE privilege checked only on the
        # root object, and owner-tier for the same reason: the registry's buckets include the external
        # RAW tier and the observability bucket, which sit outside the medallion entirely (R23), so a
        # per-tenant admin must not reach them. Registering a store is already an estate-admin door
        # (`POST /v1/stores` gates on can_observe_events), and this makes browsing one consistent with
        # that rather than strictly weaker.
        #
        # DELIBERATELY NOT a `store` type with per-store grants, and the reason is not simplicity. A
        # `store` type needs an `estate`/parent tuple per store to be reachable at all, and the four
        # SHIPPED default stores are never registered through the API — they come from `DEFAULT_STORES`
        # in code. Nothing would write their tuples, so the model would be correct and the gate would
        # deny every caller including the estate owner. A gate that denies everyone is an outage, not a
        # gate. Per-store granularity lands the day store registration owns its own tuples.
        define can_browse_storage: owner
        # Vending a WRITE credential for the estate's lineage outbox (`_lineage_outbox`), checked ONLY on
        # the root object like the two estate privileges around it. Owner-tier would be wrong here and the
        # difference is the point: the holders are SERVICES — the medallion, maintenance and ingest — and a
        # service must never be an estate owner. So this names its own role instead of widening `owner`,
        # the same shape `can_maintain` and `can_update_tag`'s `publisher` were minted for.
        #
        # The STS session policy the door builds scopes the credential to that one prefix and write tier
        # (`vending.build_session_policy(bucket, "_lineage_outbox", "write")`), so this rung buys exactly
        # "may append to the recovery log" and nothing else — not the control root around it, and not any
        # tenant's data.
        define can_stage_events: event_stager or owner

type warehouse
  relations
    define project: [project]
    # The INVERSE of `namespace#parent`, written by the same `grant_on_create` batch. It exists for one
    # reason: upward visibility (see `can_get_metadata`). Keeping it a separate edge rather than deriving
    # it is not a choice — OpenFGA cannot traverse a tuple backwards, so "is anything under me visible?"
    # is unanswerable without it.
    define child: [namespace]
    define owner: [user, role#assignee] or admin from project
    define writer: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or owner
    define reader: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or writer or member from project
    # A warehouse-level validator validates EVERY stage below it.
    define validator: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or owner
    # A warehouse-level maintainer maintains EVERY stage below it — one tuple per warehouse is how the
    # sweep is granted, which keeps the grant enumerable rather than estate-wide.
    define maintainer: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or owner
    # CLASSIFYING A COLUMN IS NOT WRITING TO IT ([[LH-058]]). Attaching a classification to a field says
    # what the data IS; it neither reads nor changes a row. The reference model makes exactly this point
    # about its own vocabulary — "independent of `modify` (separation of duties: classify without holding
    # data/DDL rights)" — and the hole it closes here was measured: `update_field_metadata` resolves to
    # `can_write_data`, so any plain WRITER could clear a classification and make their own table
    # vendable as raw object bytes again.
    #
    # NOT A `tag` TYPE, which is what the reference calls this, and the deviation is Lance's rather than
    # a preference: `tag` already means a VERSION REF in this estate (`can_create_tag`, `can_update_tag`,
    # `_refs/tags/`) because the Lance format defines it that way, and `lance_docs` outranks the
    # precedent wherever Lance has an opinion. Borrowing the word would put two unrelated things under
    # one name in the model a grant decision is read from.
    #
    # `maintainer`'s shape exactly — grantable, conditional, cascading from the parent — because it is
    # the same kind of privilege: a standing, narrow capability held by someone who is not the data's
    # owner, and one tuple per tenant should reach every tier beneath it.
    define classifier: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or owner
    # PUBLICATION is not ownership, and the model has to say so or the cascade needs `owner` on every
    # tenant. Advancing the `published` ref says which version is BLESSED; it destroys nothing, forks
    # nothing and grants nothing. `can_maintain`'s precedent, applied to the other unattended plane:
    # a maintainer rewrites HOW a dataset is stored, a publisher moves the pointer that says which
    # version consumers should read, and neither is a licence to drop, restore or re-grant.
    #
    # Measured 2026-09-10 before this existed: each of the four cascade identities held `owner` on 95
    # warehouses, bought for the single `publish` door, since `can_update_tag` had no rung below owner.
    # Granted at the WAREHOUSE for the same reason the maintainer is: one tuple per tenant reaches
    # every tier and every table beneath it, so the cascade's reach stays enumerable.
    define publisher: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or owner
    # STAGING AN EVENT is not a data rung at all, and that is why it is its own role. The lineage
    # outbox is the estate's crash-recovery seam: a producer stages the full RunEvent JSON before it
    # publishes, and the relay re-ingests whatever survives a crash. Writing there is neither reading
    # nor writing a tenant's data — the object is a bookkeeping record under a CONTROL prefix — so no
    # existing rung expresses it and reusing one would grant a tenant capability to buy a platform one.
    #
    # NOT time-boxable, unlike `writer`/`maintainer`/`publisher`: an expiry here lapses a service's
    # ability to RECOVER its own events, and the lapse is invisible — the primary publish still works,
    # so nothing fails until the crash this seam exists for. See `_CONDITIONAL_GRANT_RUNGS`'s rule:
    # decide what the expiry leaves behind, and here it leaves a backstop that looks armed.
    define event_stager: [user, role#assignee]
    # THE THREE ESTATE PRIVILEGES ARE NOT HERE, and their absence is the governance.
    #
    # `can_observe_events`, `can_browse_storage` and `can_stage_events` live on `type estate`, which is
    # what `fga_root_object` names ([[LH-055]]). Defining them here too would make them resolve on ANY
    # warehouse their owner owns, so a tenant admin would hold the estate-admin rung on their own
    # bucket and the privilege would be estate-scoped only for as long as every call site remembered to
    # name the root object. One caller checking a tenant warehouse would widen it silently. A tenant
    # cannot own an `estate:` object, so keeping them off this type is what makes the scope structural.
    #
    # `event_stager` STAYS, and is not the same thing: it is a grantable role with live tuples, whereas
    # the three above are computed usersets nothing grants. It confers nothing while no rung reads it.
    # ---- the GRANT axis (separate from the USE rungs above) ----
    # Who may hand out access here, as its own privilege rather than a side-effect of `owner`. Until
    # this existed the two were welded together — the grant routes gate on the owner bar — so
    # "may administer access but not read the data" was unexpressible, and the only way to let someone
    # run access reviews was to give them the data too. `or owner` keeps every existing owner able to
    # grant, so this adds a capability and revokes none.
    # MANAGED ACCESS — a boolean flag on the object, in the wildcard idiom (`[user:*]` is a type
    # restriction used as a switch, not a public grant: nothing reads it as "everyone", only
    # `managed_access_inheritance` below does). Turn it on and owners BELOW lose self-service
    # granting; only a grant-manager at or above this object may hand access out.
    #
    # This is the lever an archive actually wants and the rungs alone cannot express: "nobody hands
    # out access to this collection except the records manager". Without it, every owner of every
    # table is independently able to widen access, and the only way to stop them is to stop making
    # them owners — which also stops them working.
    define managed_access: [user:*, role:*]
    define managed_access_inheritance: managed_access
    # `but not managed_access_inheritance` is the whole mechanism: ownership normally carries the right
    # to grant, and this withdraws exactly that when the scope is managed, leaving the owner every
    # other power they had. `can_administer from project` is what keeps the centralized case working —
    # the authority ABOVE stays able to grant here.
    #
    # THE SUBTRACTION USED TO BE MISSING AT THIS RUNG, and only at this rung — `namespace` and `table`
    # both carried it while this line read `[user, role#assignee] or owner`, under a comment describing
    # the clause it did not have. So flipping `managed_access` on a warehouse locked down every
    # namespace and table beneath it and left the warehouse owner able to grant ON THE WAREHOUSE — the
    # widest grant in the model, since `reader from parent` cascades from here to every namespace and
    # every table under it. The one grant the lock did not stop was the one with the largest blast
    # radius, which is the opposite of what "only the records manager hands out access to this
    # collection" is supposed to mean.
    #
    # NOT `from parent`, unlike the rungs below: a warehouse's parent is a `project`, which has no
    # managed_access of its own. The flag on a warehouse is about THIS warehouse.
    #
    # `can_administer from project` is REQUIRED, not a nicety, and it is not a widening — a project
    # admin already reaches this today through `owner: [...] or admin from project`, so this clause
    # preserves authority that exists rather than granting new authority. Without it the model would
    # deadlock: `can_set_managed_access` is `manage_grants`, so the flag would withdraw the only
    # relation able to clear it, and with no rung above to reach in, one write would freeze that
    # bucket's access administration permanently. It plays exactly the part `manage_grants from parent`
    # plays one rung down.
    define manage_grants: [user, role#assignee] or (owner but not managed_access_inheritance) or can_administer from project
    # The GRANT OPTION: hand on a rung you hold yourself, and nothing more. Deliberately NOT
    # self-passing — `can_grant_pass_grants` is `manage_grants` alone below, so a delegate cannot mint
    # further delegates and the chain stays one hop deep. Not time-boxable for the same reason `owner`
    # is not: an expiring right to delegate leaves permanent grants behind it.
    #
    # MANAGED ACCESS WITHDRAWS THIS TOO, and it did not until 2026-08-16. Withdrawing it from
    # `manage_grants` alone left the whole control bypassable: `can_grant_reader` is
    # `manage_grants or (reader and pass_grants)`, so an owner who ALSO held the grant option kept
    # granting reader, writer and validator through the second branch after the first was closed.
    # Measured with the real evaluator before the fix — owner + pass_grants in a managed warehouse:
    # can_grant_owner false, and can_grant_reader/writer/validator all TRUE. Only the owner-tier
    # grants were ever actually withdrawn.
    #
    # The subtraction is on the ROLE rather than on each `can_grant_*`, because a `can_*` relation is
    # a permission that COMBINES roles — the assignment logic belongs in the role it qualifies
    # (skills/openfga design-permissions). One edit, all three `can_grant_*` sites, no chance of
    # closing two and missing the third.
    #
    # Bare `managed_access_inheritance`, matching this rung's `manage_grants` exactly: a warehouse's
    # parent is a project, which has no managed_access, so the flag here is about THIS warehouse.
    define pass_grants: [user, role#assignee] but not managed_access_inheritance
    # ---- actions ----
    # UPWARD VISIBILITY: readable if you hold `reader` here, OR if anything beneath you is visible.
    # Without the second clause a grant on one table is unreachable — the grantee can read the table
    # and cannot see the warehouse or namespace that contains it, so every list above it is empty and
    # the breadcrumb to their own data 403s. Metadata only: seeing that a container exists on the path
    # to something you were deliberately given is not a leak, and it is the whole browse story.
    define can_get_metadata: reader or can_get_metadata from child
    # NOTIFICATION delivery, and it is deliberately NOT `can_get_metadata`.
    #
    # `can_get_metadata` answers "is there anything beneath this you may see?" — that is the right
    # question for rendering a breadcrumb and the WRONG one for interrupting someone. Since C1 it
    # reads `reader or can_get_metadata from child`, so a subject holding `reader` on ONE table three
    # namespaces down passes it here. Correct for browsing; as a delivery gate it would push a
    # container-scoped governance event to everyone holding a grant on anything underneath — an
    # audience nobody chose, arriving as a notification. That is the exact failure the notification
    # plane exists to end (open_notifications.md §3.1), reintroduced through a relation whose own
    # purpose is unrelated.
    #
    # A notification asserts a stake in the OBJECT ITSELF, so this is bare `reader`. It lives in the
    # model rather than as a bare-rung check in the notifications service because the model, not the
    # app, owns the op->privilege mapping — and as a `can_*` it takes no direct assignment, it names
    # a role (§10.4).
    define can_be_notified: reader
    define can_create_namespace: writer
    define can_create_table: writer
    # The warehouse root is ALSO the create-on-parent target for a TOP-LEVEL child (no enclosing
    # namespace) when `fga_lock_root_create` is on, so every `can_create_*` the app can check on a parent
    # must exist on BOTH `namespace` and `warehouse` — otherwise the check 400s ("relation not found") and
    # fails closed to a 503 for everyone. Same writer rung as can_create_table.
    define can_create_materialized_view: writer
    # THE ESTATE-ADMIN RUNG. Checked ONLY on the root object (`fga_root_object`), never on a
    # caller-supplied one, so there is nothing to inject. Owner-tier: authz scope == data scope, and a
    # per-project admin must not reach an estate-wide surface.
    #
    # **THE NAME UNDERSTATES IT, AND THAT IS THE THING TO KNOW BEFORE GRANTING IT.** This comment used
    # to describe only `GET /v1/events`, which reads as "grant this and someone can watch a feed".
    # Measured across the estate 2026-09-15, holding it also grants:
    #   * `GET /v1/events` — every project's governance changes (`endpoints/events.py:59`)
    #   * `POST /v1/projects` + the project list/get — i.e. CREATING TENANTS (`endpoints/projects.py:184,246`)
    #   * the raw-tuple admin route — reading and MUTATING the authorization graph itself
    #     (`endpoints/access_admin.py:199`)
    #   * `POST /v1/stores` and its attach/detach siblings — naming a host the estate will talk to
    #     (`endpoints/stores.py:105,135,197`)
    #   * lineage's whole-estate projection (`api/fga_deps.py:144` in services/lineage)
    #   * the `estate_admin` flag `/v1/me` reports (`endpoints/me.py:62`) — a display lookup rather than
    #     a door, listed because it is a consumer and the gate below derives its list from the code
    # The viewer and controlplane gate their own estate reads on their own relations and merely CITE
    # this one for contrast, so they are deliberately absent.
    # So this is not an observer rung wearing an admin's name — it IS the admin rung, and "observe" is
    # the weakest thing it permits. Renaming it is [[LH-076]]'s other half and needs an owner call,
    # because the string appears in seeded tuples; correcting what it CLAIMS needs nobody's permission.
    #
    # Pinned by `tests/unit/test_the_estate_rung_documents_everything_it_gates.py`, which derives the
    # consumer list from the code rather than trusting this comment — the drift it closes is exactly
    # the one that produced the old text.

    # ---- grant actions, one per assignable rung ----
    # `manage_grants` grants anything here; a `pass_grants` holder may hand on ONLY what they already
    # hold. This is SQL's WITH GRANT OPTION, and the second clause is what makes the split useful
    # rather than decorative: without it, delegating any granting at all means delegating all of it.
    define can_grant_owner: manage_grants
    define can_grant_writer: manage_grants or (writer and pass_grants)
    define can_grant_reader: manage_grants or (reader and pass_grants)
    define can_grant_validator: manage_grants or (validator and pass_grants)
    # The same tier as its three neighbours, and at the SAME level as the rung it confers:
    # `classifier` cascades `... from parent`, so a tenant grant made here reaches every table
    # beneath it. Declaring the rung without its grant action is how it ended up ungated one
    # level down — caught by `test_grant_routes_are_intercepted_before_the_resolver`.
    define can_grant_classifier: manage_grants or (classifier and pass_grants)
    # Both meta-rungs are `manage_grants`-only. `can_grant_owner` is too: ownership is the authority to
    # hand out authority, so passing it through the grant option would let a delegate exceed the rung
    # they were delegated.
    define can_grant_manage_grants: manage_grants
    define can_grant_pass_grants: manage_grants
    # REVOKING is `manage_grants` alone, and is NOT the mirror of `can_grant_<rung>`.
    # It was, and the symmetry was wrong. `can_grant_reader` is `manage_grants or (reader and
    # pass_grants)`, so routing revoke at it let a DELEGATE strip grants they never issued: kevin,
    # holding `writer` + `pass_grants` and nothing else, could delete carol's `reader` — and every
    # other reader/writer/validator tuple on the object, including the ones the owner issued. The old
    # rule's stated justification ("a weaker revoke bar would let a delegate strip the owner who
    # delegated to them") is satisfied only for `owner`; at and below the delegate's own rung it was
    # not satisfied at all.
    # SQL's WITH GRANT OPTION lets a delegate revoke the grants THEY made. That needs the granting
    # actor recorded ON the tuple, which this store does not carry, so the honest bar is the
    # conservative one: a delegate may hand out what they hold and may not take anything back.
    # Owners keep it — `manage_grants` derives from `owner` — except inside a managed scope, which is
    # exactly what C4's flag is for.
    define can_revoke_grant: manage_grants
    # Seeing who holds what follows from being able to CHANGE who holds what — the same bar, derived
    # rather than restated, so a rung added above cannot leave this behind.
    define can_read_assignments: manage_grants
    # Turning managed access on or off is itself a grant-management act. Note what this means one
    # level down: on a namespace ALREADY inside a managed scope, the owner's `manage_grants` is
    # withdrawn, so they cannot clear the flag either — a policy you can switch off is not a policy.
    define can_set_managed_access: manage_grants

# Namespace = a medallion stage (bronze/silver/gold) or a domain namespace; self-nesting under a warehouse.
type namespace
  relations
    define parent: [warehouse, namespace]
    # The inverse edge — see `warehouse#child`. `materialized_view` is here and `transaction` is not:
    # a view is a browsable object someone can be granted, a transaction is a receipt that no one
    # navigates to.
    define child: [namespace, table, materialized_view]
    define owner: [user, role#assignee] or owner from parent
    define writer: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or owner or writer from parent
    define reader: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or writer or reader from parent
    # The validator rung is SEPARATE from writer — a writer is NOT a validator. Inherits from the parent
    # so a warehouse/parent validator validates this stage. This is what gates promotion INTO the stage.
    define validator: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or owner or validator from parent
    # The maintainer rung is SEPARATE from writer IN BOTH DIRECTIONS, which is the whole point of it.
    # A writer is not a maintainer, and — the half that matters — a MAINTAINER IS NOT A WRITER: the
    # sweep may rewrite a dataset's files and reclaim its versions, and may not change what the data
    # says. Granting the sweep `writer` estate-wide would have made one compromised maintenance pod
    # equivalent to compromising every table (owner ruling 2026-09-08: zero trust).
    define maintainer: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or owner or maintainer from parent
    # The classifier rung, cascading like `maintainer` — one grant per tenant reaches every table
    # beneath it. See `type warehouse` for why this is not the reference's `tag` type.
    define classifier: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or owner or classifier from parent
    # Publication, inherited — see the `warehouse` rung. A publisher here may bless a version of any
    # table in this stage without being able to destroy one.
    define publisher: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or owner or publisher from parent
    # ---- the GRANT axis ---- (see `warehouse` for why it is separate from the rungs above)
    # Managed access, inherited: setting the flag on the warehouse governs every stage beneath it, and
    # a stage may also set it for itself. The recursion is what makes "manage this collection centrally"
    # one act rather than one act per object.
    define managed_access: [user:*, role:*]
    define managed_access_inheritance: managed_access or managed_access_inheritance from parent
    # Cascades like every other rung: a warehouse grant-manager manages grants on every stage beneath
    # it, so access administration is delegated once at the top rather than re-granted per namespace.
    # `(ownership but not managed_access_inheritance from parent)` — an owner grants here UNLESS the
    # enclosing scope is managed, in which case only a manager from above can.
    define manage_grants: [user, role#assignee] or (owner but not managed_access_inheritance from parent) or manage_grants from parent
    # The grant option does NOT cascade — it is deliberately per-object. Inheriting it would mean one
    # `pass_grants` at the warehouse silently made someone a delegate on every table underneath, which
    # is the blanket authority `manage_grants` already expresses honestly.
    #
    # It IS withdrawn by a managed enclosing scope, under exactly the condition that withdraws
    # `manage_grants` one line up — `from parent`, so the flag set ON this namespace constrains
    # everything beneath it and not its own owner ("cleared from ABOVE, never from inside"). Using the
    # bare form here would strip a delegate at the very rung whose owner keeps granting, which is the
    # same rule pointing two ways.
    define pass_grants: [user, role#assignee] but not managed_access_inheritance from parent
    # ---- actions ----
    # Upward visibility — same rule and same reason as `warehouse#can_get_metadata`. Recursive through
    # `child: [namespace, ...]`, so a grant nested three namespaces deep lights the whole path to it.
    define can_get_metadata: reader or can_get_metadata from child
    # NOTIFICATION delivery, and it is deliberately NOT `can_get_metadata` — see `warehouse` above for
    # the full reasoning. In one line: `can_get_metadata` answers "is there anything beneath this you
    # may see?", which is right for a breadcrumb and wrong for interrupting someone, and since C1 it
    # reaches up from a grant nested arbitrarily deep. A notification asserts a stake in the OBJECT
    # ITSELF, so this is bare `reader`.
    define can_be_notified: reader
    define can_create_namespace: writer
    define can_create_table: writer
    # Creating a materialized view is a create-on-parent op gated on the enclosing namespace (writer rung),
    # exactly like can_create_table — the view itself does not exist yet at authorization time.
    define can_create_materialized_view: writer
    define can_update_properties: writer
    define can_promote: validator
    define can_delete: owner
    # Arming or disarming deletion protection on a namespace — the table rung's twin, one level up, and
    # at the same tier as the `can_delete` it guards. See `type table`'s `can_set_protection` for why a
    # distinct action at an identical tier costs nobody a permission and buys back the audit trail.
    define can_set_protection: owner
    # ---- grant actions ---- (same shape as `warehouse`; see there for the reasoning)
    define can_grant_owner: manage_grants
    define can_grant_writer: manage_grants or (writer and pass_grants)
    define can_grant_reader: manage_grants or (reader and pass_grants)
    define can_grant_validator: manage_grants or (validator and pass_grants)
    # The same tier as its three neighbours, and at the SAME level as the rung it confers:
    # `classifier` cascades `... from parent`, so a tenant grant made here reaches every table
    # beneath it. Declaring the rung without its grant action is how it ended up ungated one
    # level down — caught by `test_grant_routes_are_intercepted_before_the_resolver`.
    define can_grant_classifier: manage_grants or (classifier and pass_grants)
    define can_grant_manage_grants: manage_grants
    define can_grant_pass_grants: manage_grants
    # REVOKING is `manage_grants` alone, and is NOT the mirror of `can_grant_<rung>`.
    # It was, and the symmetry was wrong. `can_grant_reader` is `manage_grants or (reader and
    # pass_grants)`, so routing revoke at it let a DELEGATE strip grants they never issued: kevin,
    # holding `writer` + `pass_grants` and nothing else, could delete carol's `reader` — and every
    # other reader/writer/validator tuple on the object, including the ones the owner issued. The old
    # rule's stated justification ("a weaker revoke bar would let a delegate strip the owner who
    # delegated to them") is satisfied only for `owner`; at and below the delegate's own rung it was
    # not satisfied at all.
    # SQL's WITH GRANT OPTION lets a delegate revoke the grants THEY made. That needs the granting
    # actor recorded ON the tuple, which this store does not carry, so the honest bar is the
    # conservative one: a delegate may hand out what they hold and may not take anything back.
    # Owners keep it — `manage_grants` derives from `owner` — except inside a managed scope, which is
    # exactly what C4's flag is for.
    define can_revoke_grant: manage_grants
    define can_read_assignments: manage_grants
    define can_set_managed_access: manage_grants

type table
  relations
    define parent: [namespace]
    define owner: [user, role#assignee] or owner from parent
    define writer: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or owner or writer from parent
    define reader: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or writer or reader from parent
    define validator: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or owner or validator from parent
    # See the namespace rung for why this is separate from `writer` in both directions.
    define maintainer: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or owner or maintainer from parent
    # The classifier rung, cascading like `maintainer` — one grant per tenant reaches every table
    # beneath it. See `type warehouse` for why this is not the reference's `tag` type.
    define classifier: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or owner or classifier from parent
    # See the `warehouse` rung. Separate from `writer` in both directions for the same reason
    # `maintainer` is: writing a version and BLESSING one are different authorities, and the cascade
    # needs the second without the destructive half of the first's container.
    define publisher: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or owner or publisher from parent
    # ---- the GRANT axis ---- (see `warehouse`)
    # A table takes no `managed_access` of its own — the flag is a CONTAINER policy, and a per-table
    # switch would let an owner exempt their own table from the collection's rule, which is the rule's
    # only purpose. It still OBEYS one set above it, through `managed_access_inheritance from parent`.
    define manage_grants: [user, role#assignee] or (owner but not managed_access_inheritance from parent) or manage_grants from parent
    # Same withdrawal as the two rungs above; a table has no managed_access of its own, so the scope
    # that governs it is always its namespace's.
    define pass_grants: [user, role#assignee] but not managed_access_inheritance from parent
    # ---- actions ----
    define can_get_metadata: reader
    # NOTIFICATION delivery. Identical to `can_get_metadata` on this type — both are bare `reader` —
    # and that identity is the point rather than a redundancy: it is what makes the container split
    # above cost nothing today, so S1's delivery path was already correct and stays correct. Named
    # separately so the day a leaf's metadata rung moves, delivery does not silently move with it.
    define can_be_notified: reader
    define can_read_data: reader
    define can_write_data: writer
    # MAINTENANCE is not a write, and the model has to say so or the sweep needs `writer` on everything.
    # Compaction, index optimisation and version reclamation rewrite HOW a dataset is stored; they never
    # change WHAT it says. `can_maintain` therefore neither implies nor is implied by `can_write_data`.
    define can_maintain: maintainer
    # Writing a governance key on a FIELD (`rask.*` field metadata — today the classification that makes
    # a table unvendable as raw bytes). `classifier`, never `writer`: the whole point is that someone may
    # label data they may not read, and that someone who may WRITE rows may not un-label it.
    define can_classify: classifier
    define can_promote: validator
    define can_drop: owner
    # ARMING OR DISARMING deletion protection ([[LH-055]]). A DISTINCT ACTION over the SAME effective
    # tier as the destruction it guards — the reference model's shape, and the reason it is a non-problem
    # there that protection and drop share a tier: they are two actions, not one collapsed permission.
    #
    # `owner`, identical to the rung above, so NOBODY gains or loses anything by its arrival. That is
    # what makes naming it free, and it is the opposite of splitting the TIER: a protection rung granted
    # to a set that turns out to be empty leaves every protected object permanently stuck.
    #
    # THE COST OF NOT NAMING IT IS THE AUDIT TRAIL. `#41` audits every authorization decision by the
    # RELATION checked, so while the protection door checked `can_drop` an auditor could not tell
    # "dropped this table" from "armed the safety on it" — two opposite intentions writing the same
    # record. The route suffix is not in that record.
    #
    # DIFFERENT FROM the `branches/delete` case below, which deliberately reuses `can_drop` rather than
    # minting `can_delete_branch`: that argument is about a relation "every existing owner grant would
    # then lack", which is true of a GRANTABLE relation and false of a computed userset over `owner`.
    # This one is computed, so every owner already holds it the moment it exists.
    define can_set_protection: owner
    define can_deregister: owner
    # Ref-plane / history ops. A plain data WRITER appends/overwrites within the current line; FORKING
    # history (branch) or REWINDING it (restore) is privileged and stays at the OWNER tier —
    # admin-inclusive via the parent cascade, never grantable to a mere writer, because `can_restore`
    # is DESTRUCTIVE.
    define can_create_branch: owner
    # THE TAG RUNGS ADMIT A PUBLISHER; `can_create_branch` and `can_restore` beside them do not, and
    # that split is the whole reason the rung exists. A tag is a NAMED POINTER at a version that
    # already exists — creating or moving one destroys nothing, forks nothing and grants nothing,
    # which is categorically unlike the two it sits between.
    #
    # BOTH, not just the update: the catalog's `publish` door creates the `published` tag on first
    # publication and moves it thereafter (`publication.py::_set_tag`), gating once on the path. A
    # publisher that could only move an existing tag would be refused on every tenant's first
    # promotion and work forever after — the worst shape a permission can have.
    define can_create_tag: owner or publisher
    define can_update_tag: owner or publisher
    define can_restore: owner
    # ---- grant actions ---- (same shape as `warehouse`; see there for the reasoning)
    define can_grant_owner: manage_grants
    define can_grant_writer: manage_grants or (writer and pass_grants)
    define can_grant_reader: manage_grants or (reader and pass_grants)
    define can_grant_validator: manage_grants or (validator and pass_grants)
    # GRANTABLE THROUGH THE API, unlike `maintainer` and `publisher` — and the difference is WHO holds it.
    # Those two are service rungs the chart's bootstrap hook seeds; `classifier` is meant for a PERSON (a
    # data-protection officer labelling data they may not read), and a person's grant belongs on the grant
    # door rather than in a deploy. `_grant_actions` reads this set off the model, so without this line
    # the rung would be declared and reachable by owners alone — a separation of duties nobody could
    # actually delegate, which is the "configured but inert" shape the estate keeps catching.
    #
    # Delegation admitted (`… or (classifier and pass_grants)`) exactly as `can_grant_validator` does;
    # taking it back stays `manage_grants` alone, because revocation is administration, never delegation.
    define can_grant_classifier: manage_grants or (classifier and pass_grants)
    define can_grant_manage_grants: manage_grants
    define can_grant_pass_grants: manage_grants
    # REVOKING is `manage_grants` alone, and is NOT the mirror of `can_grant_<rung>`.
    # It was, and the symmetry was wrong. `can_grant_reader` is `manage_grants or (reader and
    # pass_grants)`, so routing revoke at it let a DELEGATE strip grants they never issued: kevin,
    # holding `writer` + `pass_grants` and nothing else, could delete carol's `reader` — and every
    # other reader/writer/validator tuple on the object, including the ones the owner issued. The old
    # rule's stated justification ("a weaker revoke bar would let a delegate strip the owner who
    # delegated to them") is satisfied only for `owner`; at and below the delegate's own rung it was
    # not satisfied at all.
    # SQL's WITH GRANT OPTION lets a delegate revoke the grants THEY made. That needs the granting
    # actor recorded ON the tuple, which this store does not carry, so the honest bar is the
    # conservative one: a delegate may hand out what they hold and may not take anything back.
    # Owners keep it — `manage_grants` derives from `owner` — except inside a managed scope, which is
    # exactly what C4's flag is for.
    define can_revoke_grant: manage_grants
    define can_read_assignments: manage_grants

# A materialized view = a derived, refreshable dataset under a namespace (id = namespace path + view
# name). Concentric rungs mirror `table`: owner ⊇ refresher ⊇ reader, all cascading from the parent
# namespace. `refresher` is the writer-equivalent rung — it gates the async REFRESH (rematerialize) op,
# a data-plane write — while `reader` only reads the view + its metadata.
type classification
    relations
        # THE CLASSIFICATION VOCABULARY ([[LH-055]], owner ruling docs/DECISIONS.md — "the FGA model
        # shape is a PORT"). The reference model declares no `column` type; column governance is a TAG
        # type with per-tag `apply`, "Independent of `modify` (separation of duties: classify without
        # holding data/DDL rights)".
        #
        # NAMED `classification`, NOT `tag`, and the deviation is Lance's rather than a preference:
        # `tag` already means a VERSION REF in this estate because the FORMAT defines it that way —
        # `can_create_tag`/`can_update_tag` on `table`, `_refs/tags/` on disk. Two meanings for one
        # identifier in an authorization model is how a check ends up answering the wrong question.
        # The ruling's substance is per-value `apply` delegation, which this is; the identifier is not.
        #
        # PER-TAG IS THE WHOLE POINT, and `classifier` on `table` is not a substitute for it. That rung
        # is ONE BIT: whoever may label anything may label everything, so a data-protection officer
        # trusted to mark `pii` is equally able to mark a table `restricted` and make it unvendable.
        # The door asks two different questions — may this subject label THIS TABLE, and may they apply
        # THIS TAG — and only a type can answer the second.
        #
        # PARENTED ON `estate`, NOT ON A TABLE OR WAREHOUSE. A per-tenant tag would put the vocabulary
        # in the hands of whoever owns the data, which is exactly the separation being built: a tenant
        # owner must not be able to mint a label, delegate it to themselves and classify their way out
        # of a policy. `parent` is typed `[estate]` alone, so the model refuses the other shape.
        define parent: [estate]
        # Minting and delegating a tag is estate administration. `admin from parent` rather than
        # `owner`, because a tag has no data and therefore no data owner.
        define curator: [user, role#assignee] or admin from parent
        # The grantable rung, time-boxable like every other DATA rung — a classification delegation is
        # exactly the kind that should be able to expire (an audit, a secondment, an incident).
        define apply: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or curator
        define can_apply: apply
        # `can_get_metadata` so a subject who may apply a tag can also SEE it in a vocabulary listing;
        # without it the door can authorize a write the caller could not have discovered how to make.
        define can_get_metadata: apply or curator
        # Delegation admitted on the grant, `curator` alone on the revoke — the asymmetry the
        # reference model states as "taking a privilege back is administration, never delegation".
        define can_grant_apply: curator or (apply and pass_grants)
        define can_revoke_apply: curator
        define pass_grants: [user, role#assignee] or curator
        # `pass_grants` is itself grantable here because `_GRANTABLE_BASE` carries it, so it needs its
        # own gate or the delegation option is handed out ungated. `curator` alone, never
        # `… and pass_grants`: a delegate who could mint further delegates turns a narrow, expiring
        # classification grant into a permanent tree nobody issued.
        define can_grant_pass_grants: curator


type materialized_view
  relations
    define parent: [namespace]
    define owner: [user, role#assignee] or owner from parent
    define refresher: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or owner or writer from parent
    define reader: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or refresher or reader from parent
    # ---- actions ----
    define can_get_metadata: reader
    # NOTIFICATION delivery. Identical to `can_get_metadata` on this type — both bare `reader` — and
    # that identity is the point rather than a redundancy: it is what makes the container split cost
    # nothing on a leaf. Named separately so the day a leaf's metadata rung moves, delivery does not
    # silently move with it.
    define can_be_notified: reader
    define can_read: reader
    define can_refresh: refresher

# A transaction = a coordination artifact scoped to the namespace/warehouse whose tables it commits
# (id = the opaque transaction path). Rungs separate the privileged LIFECYCLE (commit/abort/cancel via
# set_status) from lighter PROPERTY edits: owner ⊇ committer ⊇ editor ⊇ viewer. A `committer` may change
# the transaction status; an `editor` may only edit its properties (NOT commit/abort); a `viewer` may
# describe it. All rungs cascade from the enclosing namespace/warehouse, so a namespace writer can drive
# the transactions it opens — the fix for the old always-deny (the check used to target a `table:<txn-id>`
# object nothing ever seeds).
type transaction
  relations
    define parent: [namespace, warehouse]
    define owner: [user, role#assignee] or owner from parent
    define committer: [user, role#assignee] or owner or writer from parent
    define editor: [user, role#assignee] or committer
    define viewer: [user, role#assignee] or editor or reader from parent
    # ---- actions ----
    # `can_describe` and `can_set_status` are the two the app actually checks (api/fga_deps.py picks
    # between them by read-vs-write). `can_set_property` and `can_cancel` are defined and referenced by
    # NOTHING — no other relation, no code path (swept 2026-08-08). They are leaf permissions, so nothing
    # inherits through them and they cost only clarity; per the openfga skill's optimize-simplify rule
    # they are removal candidates, NOT removals — that rule also says never delete on a usage sweep alone,
    # and a deletion has to ship with `fga model test` green. Left in place with the finding recorded
    # rather than half-done: `alter_transaction` is the endpoint that would grow the property/cancel
    # actions, and if it does, these are already the right doors.
    define can_describe: viewer
    define can_set_property: editor
    define can_set_status: committer
    define can_cancel: committer

# An annotation project = a labeling work domain owned by a tenant. Its state (tasks, claims, drafts,
# reviews) is the annotator's own and NEVER enters the governed plane until a publish — which is why this
# type hangs off `project` (the tenant) and not off warehouse/namespace. Rungs are concentric:
# owner ⊇ manager ⊇ reviewer ⊇ annotator ⊇ viewer.
#
# Two rung choices, owned (docs/DESIGN-annotation-projects.md §6.1): `reviewer ⊇ annotator` because a
# reviewer must be able to fix_and_accept, which IS annotating; and `can_publish: manager` rather than a
# fifth `publisher` rung, which would earn nothing over the manager who froze the project.
#
# Publish is deliberately a TWO-DOOR operation (§6.2) and only door 1 lives here: `can_publish` on the
# annotation_project. Door 2 is `can_create_table` on the TARGET namespace, already on both `namespace`
# and `warehouse`. Do not collapse them — the annotator's domain must never imply governed-plane write.
type annotation_project
  relations
    define tenant: [project]
    define owner: [user, role#assignee] or admin from tenant
    define manager: [user, role#assignee] or owner
    define reviewer: [user, role#assignee] or manager
    define annotator: [user, role#assignee] or reviewer
    define viewer: [user, role#assignee] or annotator or member from tenant
    # ---- actions ----
    define can_view: viewer
    define can_send_items: annotator
    define can_claim: annotator
    define can_annotate: annotator
    define can_review: reviewer
    define can_manage: manager
    define can_publish: manager

# --------------------------------------------------------------------------------------------------
# Conditions
# --------------------------------------------------------------------------------------------------
#
# TIME-BOXED ACCESS. A grant that expires on its own, so nothing has to remember to revoke it — the
# failure mode this exists to kill is the contractor who still has `writer` on bronze eight months after
# the engagement ended, because a revoke was a separate task nobody owned.
#
# `grant_time` and `grant_duration` ride the TUPLE (written once, at grant time); `current_time` is
# supplied by the CALLER in the check's context. That split is the whole design: the store holds the
# window, the caller holds the clock, and neither can drift the other.
#
# Applied to the USE rungs only — reader / writer / validator / refresher. Deliberately NOT `owner`:
# ownership is not something you lend for an hour, and a temporary owner could hand out PERMANENT access
# to someone else before their own lapsed, which silently outlives the window. Also not the structural
# edges (`parent`, `project`, `team`) — those are topology, not privilege, and an expiring parent would
# detach a table from its namespace rather than de-privilege anyone.
#
# Both forms stay assignable on every rung (`[user, ..., user with non_expired_grant, ...]`), so every
# existing permanent grant keeps working unchanged; the condition is an addition, never a migration.
condition non_expired_grant(current_time: timestamp, grant_time: timestamp, grant_duration: duration) {
  current_time < grant_time + grant_duration
}
