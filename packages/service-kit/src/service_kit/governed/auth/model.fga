model
  schema 1.1

# Lance catalog authorization model — multi-tenant ReBAC (OpenFGA / Zanzibar).
#
# Hierarchy:  team -> project -> warehouse(= one S3 bucket) -> namespace (self-nesting) -> table
#   the estate's containment rule end to end, with lance's
#   concentric-rung style (owner > writer > reader) layered on top, plus a `validator` rung.
#   `materialized_view` and `transaction` hang off namespace/warehouse and inherit the SAME rungs via
#   `parent`, so a grant on the enclosing stage reaches the views + transactions inside it.
# Privileges: concentric rungs cascade DOWN via `parent` / `project`. A SEPARATE `validator` rung gates
#   medallion stage PROMOTION (e.g. silver -> gold): a plain writer can write within a stage but cannot
#   promote INTO a gated stage; only an owner or an explicit validator can (`can_promote: validator`).
# Multi-tenancy: a team owns a project (members inherit project admin); a team can own MANY projects;
#   each project has exactly ONE warehouse (bucket). Projects are isolated — a grant on project A's
#   warehouse never reaches project B.
# Permissions: every API operation is checked against a `can_*` ACTION relation (the model, not the app,
#   owns the op->privilege mapping). Roles (`role#assignee`) are first-class subjects on every rung, so a
#   grant can target a persona, not just a single user. Teams (`team#member`) flow in INDIRECTLY — a team
#   can be assigned to a role or made a project member; the resource rungs deliberately do NOT accept
#   `team#member` directly (grant a role to the team instead), keeping team access auditable via roles.
#
# CREATE-ON-PARENT COVERAGE (audited 2026-08-08 against the openfga skill's checklist: every parent->child
#   pair either has a `can_create_<child>` door on the parent, or documents why it does not). Two pairs
#   answer "documented" rather than "door", and both answers are deliberate — recorded so the next auditor
#   running the same checklist does not re-file them as gaps:
#     project   -> warehouse / annotation_project   `can_create_warehouse` / `can_create_annotation_project`
#     warehouse -> namespace / table / mat.view     `can_create_namespace` / `_table` / `_materialized_view`
#     namespace -> namespace / table / mat.view     same three, so a nested create is gated by its enclosing stage
#     team      -> project                          NO `can_create_project`, ON PURPOSE: minting a TENANT is an
#         estate-admin operation, not a team one. `POST /v1/projects` gates on `can_observe_events` on the
#         ROOT object (services/catalog/.../projects.py) — the same owner-tier door the estate-wide feed
#         uses — and then seeds the creator's `admin` tuple. A `can_create_project` on `team` would let a
#         team lead mint tenants, which is a different (and larger) product decision than it looks.
#     namespace/warehouse -> transaction            NO `can_create_transaction`, because NO API CREATES ONE:
#         the catalog exposes only `/v1/transaction/{id}/describe` and `/alter`; transaction objects are
#         minted by the backend as part of ops that are already gated. Creation is therefore enforced
#         outside OpenFGA by construction. If a create endpoint is ever added, this line is the reminder
#         that it needs a door on `namespace` AND `warehouse` (both are allowed parents).

type user

# A team — a group of users. `team:eng#member` is usable anywhere a [user] subject is.
type team
  relations
    define member: [user]

# An assignable role (persona): `role:validators#assignee` is a first-class subject. Members can be
# users, whole teams, or other roles (nesting).
type role
  relations
    define assignee: [user, team#member, role#assignee]

# A project = a tenant. Owned by a team (members become admins). Holds one warehouse.
type project
  relations
    define team: [team]
    define admin: [user, role#assignee] or member from team
    define member: [user, team#member, role#assignee] or admin
    # ---- actions ----
    define can_administer: admin
    define can_create_warehouse: admin
    # Create-on-parent for annotation projects: the child object does not exist yet, so the door is
    # the TENANT. `member`, not `admin` — labeling is ordinary tenant work, and the creator becomes
    # the new project's owner via seed_ownership.
    define can_create_annotation_project: member

# A warehouse = exactly one S3 bucket, owned by one project. The catalog root object is a `warehouse:`.
# Concentric rungs inherit from the project (admins own; members read).
type warehouse
  relations
    define project: [project]
    define owner: [user, role#assignee] or admin from project
    define writer: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or owner
    define reader: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or writer or member from project
    # A warehouse-level validator validates EVERY stage below it.
    define validator: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or owner
    # ---- actions ----
    define can_get_metadata: reader
    define can_create_namespace: writer
    define can_create_table: writer
    # The warehouse root is ALSO the create-on-parent target for a TOP-LEVEL child (no enclosing
    # namespace) when `fga_lock_root_create` is on, so every `can_create_*` the app can check on a parent
    # must exist on BOTH `namespace` and `warehouse` — otherwise the check 400s ("relation not found") and
    # fails closed to a 503 for everyone. Same writer rung as can_create_table.
    define can_create_materialized_view: writer
    # Estate-wide control-plane event feed (GET /v1/events): observing EVERY project's governance changes is
    # a platform-admin privilege, checked ONLY on the root object (fga_root_object). Owner-tier, so a mere
    # per-project admin can NOT read the estate feed — authz scope == data scope (the feed is estate-wide).
    define can_observe_events: owner
    # Raw OBJECT-STORE browsing (#90) — the viewer's `/api/objects`, `/api/object`,
    # `/api/object/download`: an S3 list, a HEAD, and a full byte download over any bucket in the
    # store registry. Like can_observe_events this is an ESTATE-WIDE privilege checked only on the
    # root object, and owner-tier for the same reason: the registry's buckets include the external
    # RAW tier and the observability bucket, which sit outside the medallion entirely (R23), so a
    # per-tenant admin must not reach them. Registering a store is already an estate-admin door
    # (`POST /v1/stores` gates on can_observe_events), and this makes browsing one consistent with
    # that rather than strictly weaker.
    #
    # DELIBERATELY NOT a `store` type with per-store grants, and the reason is not simplicity. A
    # `store` type needs an `estate`/parent tuple per store to be reachable at all, and the four
    # SHIPPED default stores are never registered through the API — they come from `DEFAULT_STORES`
    # in code. Nothing would write their tuples, so the model would be correct and the gate would
    # deny every caller including the estate owner. A gate that denies everyone is an outage, not a
    # gate. Per-store granularity lands the day store registration owns its own tuples.
    define can_browse_storage: owner

# Namespace = a medallion stage (bronze/silver/gold) or a domain namespace; self-nesting under a warehouse.
type namespace
  relations
    define parent: [warehouse, namespace]
    define owner: [user, role#assignee] or owner from parent
    define writer: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or owner or writer from parent
    define reader: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or writer or reader from parent
    # The validator rung is SEPARATE from writer — a writer is NOT a validator. Inherits from the parent
    # so a warehouse/parent validator validates this stage. This is what gates promotion INTO the stage.
    define validator: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or owner or validator from parent
    # ---- actions ----
    define can_get_metadata: reader
    define can_create_namespace: writer
    define can_create_table: writer
    # Creating a materialized view is a create-on-parent op gated on the enclosing namespace (writer rung),
    # exactly like can_create_table — the view itself does not exist yet at authorization time.
    define can_create_materialized_view: writer
    define can_update_properties: writer
    define can_promote: validator
    define can_delete: owner

type table
  relations
    define parent: [namespace]
    define owner: [user, role#assignee] or owner from parent
    define writer: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or owner or writer from parent
    define reader: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or writer or reader from parent
    define validator: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or owner or validator from parent
    # ---- actions ----
    define can_get_metadata: reader
    define can_read_data: reader
    define can_write_data: writer
    define can_promote: validator
    define can_drop: owner
    define can_deregister: owner
    # Ref-plane / history ops (OWNER tier — admin-inclusive via the parent cascade). A plain data WRITER
    # appends/overwrites within the current line; FORKING history (branch/tag) or REWINDING it (restore)
    # is privileged. `can_restore` is DESTRUCTIVE (rewinds to an older version), so it sits strictly ABOVE
    # writer — never grantable to a mere writer.
    define can_create_branch: owner
    define can_create_tag: owner
    define can_update_tag: owner
    define can_restore: owner

# A materialized view = a derived, refreshable dataset under a namespace (id = namespace path + view
# name). Concentric rungs mirror `table`: owner ⊇ refresher ⊇ reader, all cascading from the parent
# namespace. `refresher` is the writer-equivalent rung — it gates the async REFRESH (rematerialize) op,
# a data-plane write — while `reader` only reads the view + its metadata.
type materialized_view
  relations
    define parent: [namespace]
    define owner: [user, role#assignee] or owner from parent
    define refresher: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or owner or writer from parent
    define reader: [user, role#assignee, user with non_expired_grant, role#assignee with non_expired_grant] or refresher or reader from parent
    # ---- actions ----
    define can_get_metadata: reader
    define can_read: reader
    define can_refresh: refresher

# A transaction = a coordination artifact scoped to the namespace/warehouse whose tables it commits
# (id = the opaque transaction path). Rungs separate the privileged LIFECYCLE (commit/abort/cancel via
# set_status) from lighter PROPERTY edits: owner ⊇ committer ⊇ editor ⊇ viewer. A `committer` may change
# the transaction status; an `editor` may only edit its properties (NOT commit/abort); a `viewer` may
# describe it. All rungs cascade from the enclosing namespace/warehouse, so a namespace writer can drive
# the transactions it opens — the fix for the old always-deny (the check used to target a `table:<txn-id>`
# object nothing ever seeds).
type transaction
  relations
    define parent: [namespace, warehouse]
    define owner: [user, role#assignee] or owner from parent
    define committer: [user, role#assignee] or owner or writer from parent
    define editor: [user, role#assignee] or committer
    define viewer: [user, role#assignee] or editor or reader from parent
    # ---- actions ----
    # `can_describe` and `can_set_status` are the two the app actually checks (api/fga_deps.py picks
    # between them by read-vs-write). `can_set_property` and `can_cancel` are defined and referenced by
    # NOTHING — no other relation, no code path (swept 2026-08-08). They are leaf permissions, so nothing
    # inherits through them and they cost only clarity; per the openfga skill's optimize-simplify rule
    # they are removal candidates, NOT removals — that rule also says never delete on a usage sweep alone,
    # and a deletion has to ship with `fga model test` green. Left in place with the finding recorded
    # rather than half-done: `alter_transaction` is the endpoint that would grow the property/cancel
    # actions, and if it does, these are already the right doors.
    define can_describe: viewer
    define can_set_property: editor
    define can_set_status: committer
    define can_cancel: committer

# An annotation project = a labeling work domain owned by a tenant. Its state (tasks, claims, drafts,
# reviews) is the annotator's own and NEVER enters the governed plane until a publish — which is why this
# type hangs off `project` (the tenant) and not off warehouse/namespace. Rungs are concentric:
# owner ⊇ manager ⊇ reviewer ⊇ annotator ⊇ viewer.
#
# Two rung choices, owned (docs/DESIGN-annotation-projects.md §6.1): `reviewer ⊇ annotator` because a
# reviewer must be able to fix_and_accept, which IS annotating; and `can_publish: manager` rather than a
# fifth `publisher` rung, which would earn nothing over the manager who froze the project.
#
# Publish is deliberately a TWO-DOOR operation (§6.2) and only door 1 lives here: `can_publish` on the
# annotation_project. Door 2 is `can_create_table` on the TARGET namespace, already on both `namespace`
# and `warehouse`. Do not collapse them — the annotator's domain must never imply governed-plane write.
type annotation_project
  relations
    define tenant: [project]
    define owner: [user, role#assignee] or admin from tenant
    define manager: [user, role#assignee] or owner
    define reviewer: [user, role#assignee] or manager
    define annotator: [user, role#assignee] or reviewer
    define viewer: [user, role#assignee] or annotator or member from tenant
    # ---- actions ----
    define can_view: viewer
    define can_send_items: annotator
    define can_claim: annotator
    define can_annotate: annotator
    define can_review: reviewer
    define can_manage: manager
    define can_publish: manager

# --------------------------------------------------------------------------------------------------
# Conditions
# --------------------------------------------------------------------------------------------------
#
# TIME-BOXED ACCESS. A grant that expires on its own, so nothing has to remember to revoke it — the
# failure mode this exists to kill is the contractor who still has `writer` on bronze eight months after
# the engagement ended, because a revoke was a separate task nobody owned.
#
# `grant_time` and `grant_duration` ride the TUPLE (written once, at grant time); `current_time` is
# supplied by the CALLER in the check's context. That split is the whole design: the store holds the
# window, the caller holds the clock, and neither can drift the other.
#
# Applied to the USE rungs only — reader / writer / validator / refresher. Deliberately NOT `owner`:
# ownership is not something you lend for an hour, and a temporary owner could hand out PERMANENT access
# to someone else before their own lapsed, which silently outlives the window. Also not the structural
# edges (`parent`, `project`, `team`) — those are topology, not privilege, and an expiring parent would
# detach a table from its namespace rather than de-privilege anyone.
#
# Both forms stay assignable on every rung (`[user, ..., user with non_expired_grant, ...]`), so every
# existing permanent grant keeps working unchanged; the condition is an addition, never a migration.
condition non_expired_grant(current_time: timestamp, grant_time: timestamp, grant_duration: duration) {
  current_time < grant_time + grant_duration
}
