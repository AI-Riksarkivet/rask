{
	"name": "@rask/ui",
	"version": "0.1.0",
	"type": "module",
	"license": "MIT",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.stories.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./button": {
			"types": "./dist/components/button/index.d.ts",
			"svelte": "./dist/components/button/index.js"
		},
		"./badge": {
			"types": "./dist/components/badge/index.d.ts",
			"svelte": "./dist/components/badge/index.js"
		},
		"./dialog": {
			"types": "./dist/components/dialog/index.d.ts",
			"svelte": "./dist/components/dialog/index.js"
		},
		"./dropdown-menu": {
			"types": "./dist/components/dropdown-menu/index.d.ts",
			"svelte": "./dist/components/dropdown-menu/index.js"
		},
		"./avatar": {
			"types": "./dist/components/avatar/index.d.ts",
			"svelte": "./dist/components/avatar/index.js"
		},
		"./card": {
			"types": "./dist/components/card/index.d.ts",
			"svelte": "./dist/components/card/index.js"
		},
		"./sort-header": {
			"types": "./dist/components/sort-header/index.d.ts",
			"svelte": "./dist/components/sort-header/index.js"
		},
		"./sidebar": {
			"types": "./dist/components/sidebar/index.d.ts",
			"svelte": "./dist/components/sidebar/index.js"
		},
		"./shell": {
			"types": "./dist/shell/index.d.ts",
			"svelte": "./dist/shell/index.js"
		},
		"./utils": {
			"types": "./dist/utils/index.d.ts",
			"default": "./dist/utils/index.js"
		},
		"./styles/tokens.css": "./dist/styles/tokens.css"
	},
	"scripts": {
		"dev": "svelte-package -w",
		"build": "svelte-package && publint",
		"package": "svelte-package",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"bits-ui": "^2.18.0",
		"clsx": "^2.1.1",
		"@lucide/svelte": "^1.21.0",
		"lucide-svelte": "^1.0.1",
		"tailwind-merge": "^2.5.0",
		"tailwind-variants": "^0.3.0"
	},
	"devDependencies": {
		"@storybook/addon-a11y": "^10.4.6",
		"@storybook/addon-docs": "^10.4.6",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-themes": "^10.4.6",
		"@storybook/svelte": "^10.4.6",
		"@storybook/svelte-vite": "^10.4.6",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.1",
		"publint": "^0.3.21",
		"storybook": "^10.4.6",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.1",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.9"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts"
}
