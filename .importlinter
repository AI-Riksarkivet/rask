# Import-layer contracts, run by `make lint-imports` (part of `make check`). Each names a layer that must
# not import another; lint-imports walks the whole import graph, function-local (lazy) imports included,
# and names the offending chain. `dapr` is a root package because import-linter cannot forbid an external
# SUBPACKAGE (`dapr.ext.workflow`) otherwise, and include_external_packages lets the other third-party
# names (ray, durabletask, fastapi, starlette, dotenv) be forbidden directly.

[importlinter]
root_packages =
    catalog
    lineage
    maintenance
    notifications
    annotator
    service_kit
    lineage_kit
    ray_kit
    compute
    dapr
include_external_packages = True

[importlinter:contract:catalog-api-speaks-the-spec-taxonomy]
name = catalog.api raises the Lance Namespace spec taxonomy, never the fleet exceptions
type = forbidden
source_modules =
    catalog.api
forbidden_modules =
    service_kit.exceptions
allow_indirect_imports = True

# The lakehouse knows no engine (ADR 0155): moving data between tiers is the user's pipeline on their own compute, so no
# lakehouse service and no shared kit imports an engine, an engine's kit, or the compute app.
[importlinter:contract:the-lakehouse-knows-no-engine]
name = Phase 1 (3): no lakehouse service and no service-kit module imports an engine or an engine adapter
type = forbidden
source_modules =
    catalog
    lineage
    maintenance
    notifications
    service_kit
    lineage_kit
forbidden_modules =
    ray
    ray_kit
    compute
allow_indirect_imports = True

# The lakehouse knows no annotation tool (ADR 0171): rask's annotator, like Label Studio, is a client that reaches the
# lakehouse through its public doors. A client may import the shared library; the lakehouse may not import a client.
[importlinter:contract:the-lakehouse-knows-no-annotation-tool]
name = XC-167: no lakehouse service and no shared kit imports the annotator
type = forbidden
source_modules =
    catalog
    lineage
    maintenance
    notifications
    service_kit
    lineage_kit
forbidden_modules =
    annotator
allow_indirect_imports = True

[importlinter:contract:the-lakehouse-is-not-built-on-a-workflow-engine]
name = Phase 1 (3): no lakehouse service imports a workflow engine
type = forbidden
source_modules =
    catalog
    lineage
    maintenance
    service_kit
forbidden_modules =
    dapr.ext.workflow
    durabletask
allow_indirect_imports = True

[importlinter:contract:settings-import-no-web-stack]
name = importing service_kit.config builds no app-factory graph
type = forbidden
source_modules =
    service_kit.config
forbidden_modules =
    fastapi
    starlette
    service_kit.app
    service_kit.middleware
    service_kit.probes

[importlinter:contract:the-error-types-import-no-app-factory]
name = importing service_kit.exceptions loads neither the app factory nor its dotenv read
type = forbidden
source_modules =
    service_kit.exceptions
forbidden_modules =
    service_kit.app
    dotenv

[importlinter:contract:the-annotation-domain-core-never-reaches-the-lakehouse]
name = importing annotator.projects pulls in no lancekit / registry
type = forbidden
source_modules =
    annotator.projects.machines
    annotator.projects.models
    annotator.projects.ontology
forbidden_modules =
    service_kit.lancekit

# Neither kit declares the other, so an import across would pass in the root venv and fail in an image whose closure
# lacks the package. What crosses between them is a callable (a key loader, a key parser, a secret fetch) or a name
# spelled out on both sides (the door modes).
[importlinter:contract:the-two-kits-import-neither-way]
name = service_kit and lineage_kit never import each other
type = independence
modules =
    service_kit
    lineage_kit
