# Import-layer contracts, run by `make lint-imports` (part of `make check`). Each names a layer that must
# not import another; lint-imports walks the whole import graph, function-local (lazy) imports included,
# and names the offending chain. `dapr` is a root package because import-linter cannot forbid an external
# SUBPACKAGE (`dapr.ext.workflow`) otherwise, and include_external_packages lets the other third-party
# names (ray, durabletask, fastapi, starlette, dotenv) be forbidden directly. Every first-party package the
# lakehouse imports is a root package too (`storage`): an external package's own imports are not in the
# graph, so a client imported through one would pass every contract.

[importlinter]
root_packages =
    catalog
    lineage
    maintenance
    notifications
    annotator
    flows
    search
    viewer
    service_kit
    lineage_kit
    storage
    ray_kit
    compute
    table_maintenance
    dapr
include_external_packages = True

[importlinter:contract:catalog-api-speaks-the-spec-taxonomy]
name = catalog.api raises the Lance Namespace spec taxonomy, never the fleet exceptions
type = forbidden
source_modules =
    catalog.api
forbidden_modules =
    service_kit.exceptions
allow_indirect_imports = True

# The lakehouse knows no client (XC-175): flows, search, the viewer, the annotator (ADR 0171), compute and the engine it
# fronts (ADR 0155) reach the lakehouse only through its public doors, so deleting every client changes nothing in the
# lakehouse. A client may import the shared kits; no lakehouse service and no kit it runs imports a client, by any chain.
[importlinter:contract:the-lakehouse-knows-no-client]
name = Phase 1 (3), XC-176: no lakehouse service and no shared kit imports a client, an engine or an engine's kit
type = forbidden
source_modules =
    catalog
    lineage
    maintenance
    notifications
    service_kit
    lineage_kit
forbidden_modules =
    flows
    search
    viewer
    annotator
    compute
    ray
    ray_kit
    table_maintenance

# service-kit still carries code only clients run: the media plane, and the lancekit modules whose only importers are the
# media services and the annotator. No lakehouse service and no lineage-kit module reaches that code by any chain, a
# type-only import included, so it can leave the kit without a lakehouse change.
[importlinter:contract:the-lakehouse-reaches-no-client-code-in-the-kit]
name = XC-176: no lakehouse service and no lineage-kit module reaches the media plane or a client-only lancekit module
type = forbidden
source_modules =
    catalog
    lineage
    maintenance
    notifications
    lineage_kit
forbidden_modules =
    service_kit.media
    service_kit.lancekit.alignments
    service_kit.lancekit.descriptor
    service_kit.lancekit.introspect
    service_kit.lancekit.keys
    service_kit.lancekit.openlineage
    service_kit.lancekit.predicate
    service_kit.lancekit.registry
    service_kit.lancekit.store
    service_kit.lancekit.topics_meta

[importlinter:contract:the-lakehouse-is-not-built-on-a-workflow-engine]
name = Phase 1 (3): no lakehouse service and no shared kit imports a workflow engine
type = forbidden
source_modules =
    catalog
    lineage
    maintenance
    notifications
    service_kit
    lineage_kit
forbidden_modules =
    dapr.ext.workflow
    durabletask
allow_indirect_imports = True

[importlinter:contract:settings-import-no-web-stack]
name = importing service_kit.config builds no app-factory graph
type = forbidden
source_modules =
    service_kit.config
forbidden_modules =
    fastapi
    starlette
    service_kit.app
    service_kit.middleware
    service_kit.probes

[importlinter:contract:the-error-types-import-no-app-factory]
name = importing service_kit.exceptions loads neither the app factory nor its dotenv read
type = forbidden
source_modules =
    service_kit.exceptions
forbidden_modules =
    service_kit.app
    dotenv

[importlinter:contract:the-annotation-domain-core-never-reaches-the-lakehouse]
name = importing annotator.projects pulls in no lancekit / registry
type = forbidden
source_modules =
    annotator.projects.machines
    annotator.projects.models
    annotator.projects.ontology
forbidden_modules =
    service_kit.lancekit

# Neither kit declares the other, so an import across would pass in the root venv and fail in an image whose closure
# lacks the package. What crosses between them is a callable (a key loader, a key parser, a secret fetch) or a name
# spelled out on both sides (the door modes).
[importlinter:contract:the-two-kits-import-neither-way]
name = service_kit and lineage_kit never import each other
type = independence
modules =
    service_kit
    lineage_kit

# A bring-your-own job reaches the lakehouse through its doors alone ([[LH-529]], ADR 0162): the table-maintenance job
# compacts what the catalog lists as due with stock clients, so what it does is what any client may do, and it runs as
# a release of its own.
[importlinter:contract:a-bring-your-own-job-imports-no-rask-package]
name = LH-529: the table-maintenance job imports no rask package
type = forbidden
source_modules =
    table_maintenance
forbidden_modules =
    catalog
    lineage
    maintenance
    notifications
    service_kit
    lineage_kit
    storage
