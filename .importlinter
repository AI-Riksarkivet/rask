# Import-layer contracts, run by `make lint-imports` (part of `make check`). Each names a layer that must
# not import another; lint-imports walks the whole import graph, function-local (lazy) imports included,
# and names the offending chain. `dapr` is a root package because import-linter cannot forbid an external
# SUBPACKAGE (`dapr.ext.workflow`) otherwise, and include_external_packages lets the other third-party
# names (ray, durabletask, fastapi, starlette, dotenv) be forbidden directly. Every first-party package the
# lakehouse imports is a root package too: an external package's own imports are not in the graph, so a client imported
# through one would pass every contract. No client is a root package: a client lives in a repository of its own, and
# the names a client's code goes by are forbidden below as external names.

[importlinter]
root_packages =
    catalog
    lineage
    maintenance
    lakehouse
    dapr
include_external_packages = True

[importlinter:contract:catalog-api-speaks-the-spec-taxonomy]
name = catalog.api raises the Lance Namespace spec taxonomy, never the fleet exceptions
type = forbidden
source_modules =
    catalog.api
forbidden_modules =
    lakehouse.exceptions
allow_indirect_imports = True

# The lakehouse knows no client (XC-175): a client and a compute engine (ADR 0155) reach the lakehouse only through its
# public doors, so deleting every client changes nothing in the lakehouse. No lakehouse service and nothing in the
# library they run imports Ray, lance-ray or lancedb, by any chain. Each is forbidden as an external name, not a root
# package, so this file holds with no client installed. lancedb matches the lakehouse image's import gate
# (`.docker/rest-catalog.dockerfile`, `--absent`): the lakehouse reads and writes through pylance and lance-namespace,
# and lancedb is a client's library.
[importlinter:contract:the-lakehouse-knows-no-client]
name = Phase 1 (3), XC-176, XC-178, XC-188: no lakehouse service and nothing in the lakehouse library imports a client or a compute engine
type = forbidden
source_modules =
    catalog
    lineage
    maintenance
    lakehouse
forbidden_modules =
    ray
    lance_ray
    lancedb

[importlinter:contract:the-lakehouse-is-not-built-on-a-workflow-engine]
name = Phase 1 (3): no lakehouse service and nothing in the lakehouse library imports a workflow engine
type = forbidden
source_modules =
    catalog
    lineage
    maintenance
    lakehouse
forbidden_modules =
    dapr.ext.workflow
    durabletask
allow_indirect_imports = True
