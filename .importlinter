# Import-layer contracts, run by `make lint-imports` (part of `make check`). Each names a layer that must
# not import another; lint-imports walks the whole import graph, function-local (lazy) imports included,
# and names the offending chain. include_external_packages lets a third-party name (ray, dapr, durabletask,
# fastapi, starlette, dotenv) be forbidden directly, as a whole package. Every first-party package the
# lakehouse imports is a root package too: an external package's own imports are not in the graph, so a client imported
# through one would pass every contract. No client is a root package: a client lives in a repository of its own, and
# the names a client's code goes by are forbidden below as external names.

[importlinter]
root_packages =
    catalog
    lineage
    maintenance
    lakehouse
include_external_packages = True

# The lakehouse knows no client (XC-175): a client and a compute engine (ADR 0155) reach the lakehouse only through its
# public doors, so deleting every client changes nothing in the lakehouse. No lakehouse service and nothing in the
# library they run imports Ray, lance-ray or lancedb, by any chain. Each is forbidden as an external name, not a root
# package, so this file holds with no client installed. lancedb matches the lakehouse image's import gate
# (`.docker/rest-catalog.dockerfile`, `--absent`): the lakehouse reads and writes through pylance and lance-namespace,
# and lancedb is a client's library.
[importlinter:contract:the-lakehouse-knows-no-client]
name = Phase 1 (3), XC-176, XC-178, XC-188: no lakehouse service and nothing in the lakehouse library imports a client or a compute engine
type = forbidden
source_modules =
    catalog
    lineage
    maintenance
    lakehouse
forbidden_modules =
    ray
    lance_ray
    lancedb

# The library holds what more than one service uses, and the services build on it (ADR 0224): a module one service
# alone imports lives in that service, and nothing in the library reaches a service, by any chain, so no service runs
# another's code through it.
[importlinter:contract:the-library-imports-no-service]
name = ADR 0224: the lakehouse library imports no service
type = forbidden
source_modules =
    lakehouse
forbidden_modules =
    catalog
    lineage
    maintenance

# The service app is the top of the library (ADR 0224): the factory each service boots from, and the request layers only
# it installs. A service imports it and nothing else in the library does, so a layer here is installed by the factory
# alone and the rest of the library never depends on how a service is assembled. Its own modules import each other.
[importlinter:contract:the-service-app-is-imported-by-the-services-only]
name = ADR 0224: lakehouse.service_app is imported by the services only
type = protected
protected_modules =
    lakehouse.service_app
allowed_importers =
    catalog
    lineage
    maintenance

# The events build on the rest of the library and the rest does not build on them (ADR 0224): the bus, the envelope, the
# control and lineage lanes, the outbox and the signing seam import the primitives below them (the process, the auth
# plane's projected token, the store), and a service imports them to publish, take and verify. The bus's readiness
# dependency is built beside the bus (`events.bus.bus_dependency`), so nothing else in the library names the events: a
# new importer here is an edge that would let the events and the rest import each other.
[importlinter:contract:the-events-are-imported-by-the-services-only]
name = ADR 0224: lakehouse.events is imported by the services only
type = protected
protected_modules =
    lakehouse.events
allowed_importers =
    catalog
    lineage
    maintenance

# The auth plane is imported where an identity is presented or a caller judged, and nowhere else (ADR 0224): the services
# verify, decide and audit through it; inside the library the app factory installs its audit trail, and the bus and the
# store session present the pod's own identity. A new importer in the library is either one of these kinds, added here
# deliberately, or the rest of the library taking a judgement of a caller it was not built to make. Its own modules
# import each other.
[importlinter:contract:the-auth-plane-is-imported-by-the-services-and-its-named-users-only]
name = ADR 0224: lakehouse.governed is imported by the services and its named users in the library only
type = protected
protected_modules =
    lakehouse.governed
allowed_importers =
    catalog
    lineage
    maintenance
    lakehouse.service_app.factory
    lakehouse.events.bus
    lakehouse.storage.store_session

# The authorization client is one module per job inside the auth plane (ADR 0224): the writes build on the reads (a revoke
# reads what it removes) and on the ids and the model's hierarchy edge; the reads and the provisioning build on the
# resilience every call passes; the ids build on the model's types; the model as data builds on none of them. Each layer
# imports only those below it, and the two in a layer import neither each other, so no edge runs back up and a change to
# the model, the ids or the circuit is never a change to a caller of the writes.
[importlinter:contract:the-authorization-client-imports-one-way]
name = ADR 0224: the authorization client's modules import one way, writes over reads and provisioning over ids and resilience over the model
type = layers
containers =
    lakehouse.governed
layers =
    fga_writes
    fga_reads | fga_provision
    fga_ids | fga_resilience
    fga_model

# The auth plane judges a caller and presents the pod's own identity, and the bus and the store build on it to present
# that identity (ADR 0224): `events.bus` reads the projected token, `storage.store_session` the machine identity and the
# secret store. So the auth plane reaches neither of them, directly or through another module: a dependency the probe
# reads of the bus or the store is built beside it, never in the process group the auth plane imports.
[importlinter:contract:the-auth-plane-reaches-neither-the-events-nor-the-store]
name = ADR 0224: lakehouse.governed imports neither lakehouse.events nor lakehouse.storage, by any chain
type = forbidden
source_modules =
    lakehouse.governed
forbidden_modules =
    lakehouse.events
    lakehouse.storage

# The store is reached from everything above it and builds on almost nothing (ADR 0224): the clients, the credential and
# options a process signs with, its filesystem, its session, objects by key and the writes the store arbitrates. Seven
# imports into the rest of the library are its own, each named here: the store session presents the pod's ServiceAccount
# token (`governed.machine_identity`), asks whether a secret store is configured (`governed.secrets`) and runs its
# exchange loop under the process's supervisor (`process.supervision`), and the filesystem compares a location in both
# its spellings (`lancekit.base_refs`) and builds the store's readiness dependency (`process.health`); both run their
# blocking calls on the process's own threads (`process.own_threads`). Any other import,
# direct or through another module, is the store building on what builds on it.
[importlinter:contract:the-store-imports-only-its-named-dependencies-in-the-library]
name = ADR 0224: lakehouse.storage imports nothing in the library beyond its seven named imports
type = forbidden
source_modules =
    lakehouse.storage
forbidden_modules =
    lakehouse.*
ignore_imports =
    lakehouse.storage.store_session -> lakehouse.governed.machine_identity
    lakehouse.storage.store_session -> lakehouse.governed.secrets
    lakehouse.storage.store_session -> lakehouse.process.supervision
    lakehouse.storage.objectfs -> lakehouse.lancekit.base_refs
    lakehouse.storage.objectfs -> lakehouse.process.health
    lakehouse.storage.objectfs -> lakehouse.process.own_threads
    lakehouse.storage.store_session -> lakehouse.process.own_threads

# The process is what a lakehouse process is and says about itself while it runs (ADR 0203, ADR 0224): its supervised
# loops and its end, its lifecycle flags and SIGTERM drain, its dependencies' latest answers and the probes that serve
# them, the trace its records are joined by, and its logs. The bus, the store, the auth plane, the spec's answers and the
# service app all build on it, so it imports nothing else in the library, directly or through another module, beyond the
# probe's body (`schemas.health`), which the watch and the probe router answer with. A dependency that names the bus or
# the store is built beside the bus or the store, so the auth plane reaches neither through the probe.
[importlinter:contract:the-process-imports-nothing-else-in-the-library]
name = ADR 0224: lakehouse.process imports nothing else in the library beyond the probe's body
type = forbidden
source_modules =
    lakehouse.process
forbidden_modules =
    lakehouse.*
ignore_imports =
    lakehouse.process.health -> lakehouse.schemas.health
    lakehouse.process.probes -> lakehouse.schemas.health

# The problems are how a lakehouse service answers an error (ADR 0224): the RFC 9457 body and its media type, the spec's
# error mapping and the handlers every service app installs, the committed set of spec routes and the store-outage
# reading. The service app installs them and the services answer through them, so they import nothing else in the
# library, directly or through another module, beyond the request's trace id the body names as its `instance`
# (`process.correlation`).
[importlinter:contract:the-problems-import-nothing-else-in-the-library]
name = ADR 0224: lakehouse.problems imports nothing else in the library beyond the request's trace id
type = forbidden
source_modules =
    lakehouse.problems
forbidden_modules =
    lakehouse.*
ignore_imports =
    lakehouse.problems.envelope -> lakehouse.process.correlation

# The Lance table plane is the floor of the library (ADR 0224): how every service reads and judges a Lance table, from a
# version's commit time and a manifest's wire to its feature flags, its layout and a location's spellings. It is built
# on Lance and the standard library alone, and the records, the store and the services build on it, so it imports
# nothing else in the library, directly or through another module.
[importlinter:contract:the-lance-table-plane-imports-nothing-else-in-the-library]
name = ADR 0224: lakehouse.lancekit imports nothing else in the library
type = forbidden
source_modules =
    lakehouse.lancekit
forbidden_modules =
    lakehouse.*

# The catalog's records sit on the Lance table plane and the store (ADR 0224): the registries and governance records kept
# on the control root, and the hashed-key layout and prefixes they are kept by. They read a table's locations and
# feature flags through `lancekit`, read and write their records through `storage`, check a warehouse's name by
# `naming`, and the commit turns read off the loop on a thread set of their own (`process.own_threads`); each such
# import is named below, one line per edge, and nothing else in the library is imported, directly or through another
# module. The rest of the library builds on the records (`timers` claims its windows under their
# prefix, `compaction_gate` asks the base record), so an import of the rest here would make the two import each other.
[importlinter:contract:the-records-import-only-the-table-plane-the-store-and-naming]
name = ADR 0224: lakehouse.records imports nothing in the library beyond its named imports of lancekit, storage, naming and the thread sets
type = forbidden
source_modules =
    lakehouse.records
forbidden_modules =
    lakehouse.*
ignore_imports =
    lakehouse.records.base_registry -> lakehouse.lancekit.base_refs
    lakehouse.records.base_registry -> lakehouse.lancekit.features
    lakehouse.records.base_registry -> lakehouse.storage.conditional_records
    lakehouse.records.base_registry -> lakehouse.storage.options
    lakehouse.records.clone_sources -> lakehouse.lancekit.base_refs
    lakehouse.records.clone_sources -> lakehouse.lancekit.branch_layout
    lakehouse.records.clone_sources -> lakehouse.lancekit.lance_session
    lakehouse.records.clone_sources -> lakehouse.lancekit.transactions
    lakehouse.records.clone_sources -> lakehouse.storage.objectfs
    lakehouse.records.clone_sources -> lakehouse.storage.options
    lakehouse.records.clone_sources -> lakehouse.storage.stored_objects
    lakehouse.records.commit_records -> lakehouse.storage.conditional_records
    lakehouse.records.commit_records -> lakehouse.storage.options
    lakehouse.records.commit_records -> lakehouse.storage.stored_objects
    lakehouse.records.commit_turns -> lakehouse.storage.conditional_records
    lakehouse.records.commit_turns -> lakehouse.process.own_threads
    lakehouse.records.commit_turns -> lakehouse.storage.options
    lakehouse.records.data_directories -> lakehouse.lancekit.base_refs
    lakehouse.records.data_directories -> lakehouse.storage.options
    lakehouse.records.data_directories -> lakehouse.storage.stored_objects
    lakehouse.records.file_identities -> lakehouse.storage.conditional_records
    lakehouse.records.file_identities -> lakehouse.storage.objectfs
    lakehouse.records.file_identities -> lakehouse.storage.options
    lakehouse.records.file_identities -> lakehouse.storage.stored_objects
    lakehouse.records.history_fences -> lakehouse.storage.conditional_records
    lakehouse.records.history_fences -> lakehouse.storage.options
    lakehouse.records.location_claims -> lakehouse.lancekit.base_refs
    lakehouse.records.location_claims -> lakehouse.storage.conditional_records
    lakehouse.records.location_claims -> lakehouse.storage.options
    lakehouse.records.maintenance_due -> lakehouse.storage.options
    lakehouse.records.maintenance_due -> lakehouse.storage.stored_objects
    lakehouse.records.maintenance_policies -> lakehouse.storage.conditional_records
    lakehouse.records.maintenance_policies -> lakehouse.storage.options
    lakehouse.records.maintenance_policies -> lakehouse.storage.stored_objects
    lakehouse.records.maintenance_policies -> lakehouse.storage.uri
    lakehouse.records.object_records -> lakehouse.storage.options
    lakehouse.records.protection -> lakehouse.storage.options
    lakehouse.records.record_store -> lakehouse.storage.objectfs
    lakehouse.records.record_store -> lakehouse.storage.options
    lakehouse.records.record_store -> lakehouse.storage.stored_objects
    lakehouse.records.record_store -> lakehouse.storage.uri
    lakehouse.records.trash -> lakehouse.storage.conditional_records
    lakehouse.records.trash -> lakehouse.storage.objectfs
    lakehouse.records.trash -> lakehouse.storage.options
    lakehouse.records.warehouse_records -> lakehouse.naming
    lakehouse.records.warehouse_records -> lakehouse.storage.options

[importlinter:contract:the-lakehouse-is-not-built-on-a-workflow-engine]
name = Phase 1 (3): no lakehouse service and nothing in the lakehouse library imports a workflow engine
type = forbidden
source_modules =
    catalog
    lineage
    maintenance
    lakehouse
forbidden_modules =
    dapr
    durabletask
allow_indirect_imports = True
