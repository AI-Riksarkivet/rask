# Import-layer contracts, run by `make lint-imports` (part of `make check`). Each names a layer that must
# not import another; lint-imports walks the whole import graph, function-local (lazy) imports included,
# and names the offending chain. include_external_packages lets a third-party name (ray, dapr, durabletask,
# fastapi, starlette, dotenv) be forbidden directly, as a whole package. Every first-party package the
# lakehouse imports is a root package too: an external package's own imports are not in the graph, so a client imported
# through one would pass every contract. No client is a root package: a client lives in a repository of its own, and
# the names a client's code goes by are forbidden below as external names.

[importlinter]
root_packages =
    catalog
    lineage
    maintenance
    lakehouse
include_external_packages = True

[importlinter:contract:catalog-api-speaks-the-spec-taxonomy]
name = catalog.api raises the Lance Namespace spec taxonomy, never the fleet exceptions
type = forbidden
source_modules =
    catalog.api
forbidden_modules =
    lakehouse.exceptions
allow_indirect_imports = True

# The lakehouse knows no client (XC-175): a client and a compute engine (ADR 0155) reach the lakehouse only through its
# public doors, so deleting every client changes nothing in the lakehouse. No lakehouse service and nothing in the
# library they run imports Ray, lance-ray or lancedb, by any chain. Each is forbidden as an external name, not a root
# package, so this file holds with no client installed. lancedb matches the lakehouse image's import gate
# (`.docker/rest-catalog.dockerfile`, `--absent`): the lakehouse reads and writes through pylance and lance-namespace,
# and lancedb is a client's library.
[importlinter:contract:the-lakehouse-knows-no-client]
name = Phase 1 (3), XC-176, XC-178, XC-188: no lakehouse service and nothing in the lakehouse library imports a client or a compute engine
type = forbidden
source_modules =
    catalog
    lineage
    maintenance
    lakehouse
forbidden_modules =
    ray
    lance_ray
    lancedb

# The library holds what more than one service uses, and the services build on it (ADR 0224): a module one service
# alone imports lives in that service, and nothing in the library reaches a service, by any chain, so no service runs
# another's code through it.
[importlinter:contract:the-library-imports-no-service]
name = ADR 0224: the lakehouse library imports no service
type = forbidden
source_modules =
    lakehouse
forbidden_modules =
    catalog
    lineage
    maintenance

# The service app is the top of the library (ADR 0224): the factory each service boots from, and the request layers only
# it installs. A service imports it and nothing else in the library does, so a layer here is installed by the factory
# alone and the rest of the library never depends on how a service is assembled. Its own modules import each other.
[importlinter:contract:the-service-app-is-imported-by-the-services-only]
name = ADR 0224: lakehouse.service_app is imported by the services only
type = protected
protected_modules =
    lakehouse.service_app
allowed_importers =
    catalog
    lineage
    maintenance

# The events build on the rest of the library and the rest does not build on them (ADR 0224): the bus, the envelope, the
# control and lineage lanes, the outbox and the signing seam import the primitives below them (the request context, the
# supervisor, the store), and a service imports them to publish, take and verify. Inside the library only the readiness
# probe names the bus, to report its connection, so a new importer in the library is either a probe of the same kind,
# added here deliberately, or an edge that would let the events and the rest import each other.
[importlinter:contract:the-events-are-imported-by-the-services-and-the-probe-only]
name = ADR 0224: lakehouse.events is imported by the services and lakehouse.health only
type = protected
protected_modules =
    lakehouse.events
allowed_importers =
    catalog
    lineage
    maintenance
    lakehouse.health

[importlinter:contract:the-lakehouse-is-not-built-on-a-workflow-engine]
name = Phase 1 (3): no lakehouse service and nothing in the lakehouse library imports a workflow engine
type = forbidden
source_modules =
    catalog
    lineage
    maintenance
    lakehouse
forbidden_modules =
    dapr
    durabletask
allow_indirect_imports = True
