{
	"name": "rask",
	"private": true,
	"license": "AGPL-3.0-only",
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"components/apps/compute-frontend",
		"components/apps/discover-frontend",
		"components/apps/frontend",
		"components/apps/overview-frontend",
		"components/apps/storage-frontend",
		"components/apps/studio-frontend",
		"components/apps/train-frontend",
		"packages/api",
		"packages/ui"
	],
	"scripts": {
		"build": "turbo run build",
		"check": "turbo run check",
		"knip": "knip --no-config-hints",
		"check:tsgo": "turbo run check:tsgo",
		"dev": "turbo run dev",
		"dev:ui": "turbo run dev --filter=@rask/ui",
		"dev:frontend": "turbo run dev --filter=viewer-frontend...",
		"dev:overview": "turbo run dev --filter=overview-frontend...",
		"dev:storage": "turbo run dev --filter=storage-frontend...",
		"dev:compute": "turbo run dev --filter=compute-frontend...",
		"dev:discover": "turbo run dev --filter=discover-frontend...",
		"dev:train": "turbo run dev --filter=train-frontend...",
		"dev:studio": "turbo run dev --filter=studio-frontend...",
		"storybook": "bun --cwd=packages/ui run storybook",
		"build-storybook": "turbo run build-storybook",
		"test": "turbo run test",
		"lint": "prettier --check '{components/apps/frontend,components/apps/overview-frontend,components/apps/storage-frontend,components/apps/compute-frontend,components/apps/discover-frontend,components/apps/train-frontend,components/apps/studio-frontend,packages/api,packages/ui}/**/*.{ts,js,svelte,css,html,json,md}' '*.{json,md}' --ignore-path .gitignore && eslint components/apps/frontend components/apps/overview-frontend components/apps/storage-frontend components/apps/compute-frontend components/apps/discover-frontend components/apps/train-frontend components/apps/studio-frontend packages/ui",
		"lint:fix": "eslint components/apps/frontend components/apps/overview-frontend components/apps/storage-frontend components/apps/compute-frontend components/apps/discover-frontend components/apps/train-frontend components/apps/studio-frontend packages/ui --fix",
		"format": "prettier --write '{components/apps/frontend,components/apps/overview-frontend,components/apps/storage-frontend,components/apps/compute-frontend,components/apps/discover-frontend,components/apps/train-frontend,components/apps/studio-frontend,packages/api,packages/ui}/**/*.{ts,js,svelte,css,html,json,md}' '*.{json,md}' --ignore-path .gitignore"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@typescript/native-preview": "^7.0.0-dev.20260622.1",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"knip": "^6.18.0",
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte-check": "^4.6.0",
		"turbo": "2.9.18",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.0"
	},
	"prettier": {
		"useTabs": true,
		"singleQuote": true,
		"trailingComma": "all",
		"printWidth": 100,
		"plugins": [
			"prettier-plugin-svelte",
			"prettier-plugin-tailwindcss"
		],
		"overrides": [
			{
				"files": "*.svelte",
				"options": {
					"parser": "svelte"
				}
			}
		]
	}
}
