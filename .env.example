# rask — local env template. Copy to `.env` and fill in.
# `.env` is gitignored; this file is committed.
# Read by the host-side scripts and services through python-dotenv (`load_dotenv`).

# The object store / S3. The compose stack's RustFS answers on the host at :9000 and takes the pair written to
# .docker/secrets/object-store-{access,secret}-key; put the same pair here.
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=rustfsadmin
AWS_REGION=us-east-1
HCP_ENDPOINT=http://localhost:9000
HCP_INSECURE=true
# Ray
# RAY_ADDRESS is intentionally NOT set globally: it is a ray:// CLIENT address that
# hijacks the Job SDK (JobSubmissionClient) in the HTTP services. ray-head sets
# RAY_ADDRESS=auto itself; the runner runs inside ray-head.
RAY_DASHBOARD_URL=http://ray-head:8265
RAY_ENABLE_UV_RUN_RUNTIME_ENV=0
# Serve sizing (read by runners/htr's deploy scripts)
RASK_SERVE_REPLICAS=1
RASK_SERVE_GPU_FRAC=1.0
# API prefix — frontend (@rask/api) uses unversioned /api; the backends and the chart's routes align on it.
RASK_API_PREFIX=/api

# HuggingFace token — required to pull the GATED Riksarkivet TrOCR model
# (trocr-base-handwritten-hist-swe-3). Get one at https://huggingface.co/settings/tokens
# with read access to the gated repo. Leave blank if the model is public/cached.
HF_TOKEN=

# ── branch-only keys (carried from chore/adopt-ra-skills-marketplace) ──
RASK_BATCH_MASTER_CSV=/path/to/batches.csv
# IIIF source for the runner + scripts
IIIF_URL=https://iiifintern-ai.ra.se
# HCP basic-auth derivation (ra-hcp profile); alt to AWS_* keys above
# HCP_USERNAME=changeme
# HCP_PASSWORD=changeme
