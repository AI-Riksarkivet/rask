# rask — local env template. Copy to `.env` and fill in.
# `.env` is gitignored; this file is committed.

# ── viewer (FastAPI backend) ─────────────────────────────────────────
RASK_VIEWER_INPUT=s3://images-batch
RASK_VIEWER_OUTPUT=s3://images-batch-alto

# Optional overrides — defaults are derived from the repo root.
# RASK_BATCHES_DB=.cache/batches.db
# RASK_SCRIPTS_DIR=components/scripts
# RASK_SPA_BUILD=components/apps/frontend/build

# ── HCP / MinIO object store ──────────────────────────────────────────
HCP_ENDPOINT=https://hcp.example.com
HCP_USERNAME=changeme
HCP_PASSWORD=changeme
# HCP_CA_BUNDLE=/etc/ssl/certs/hcp-ca.pem
# HCP_INSECURE=false

# Set directly if you don't want HCP_USERNAME/HCP_PASSWORD derivation.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── search / catalog (Lance datasets in S3) ───────────────────────────
RASK_SEARCH_BUCKET=images-batch-search

# ── ray cluster ───────────────────────────────────────────────────────
RAY_DASHBOARD_URL=http://localhost:8265

# ── scripts (build_batches_db, submit_chunks) ─────────────────────────
RASK_BATCH_MASTER_CSV=/path/to/batches.csv
IIIF_URL=https://iiifintern-ai.ra.se
