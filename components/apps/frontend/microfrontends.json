{
	"$schema": "https://turborepo.dev/microfrontends/schema.json",
	"applications": {
		"viewer-frontend": {
			"development": { "local": { "port": 5173 } }
		},
		"storage-frontend": {
			"development": { "local": { "port": 5174 } },
			"routing": [{ "paths": ["/default/storage", "/default/storage/:path*"] }]
		},
		"compute-frontend": {
			"development": { "local": { "port": 5175 } },
			"routing": [{ "paths": ["/default/compute", "/default/compute/:path*"] }]
		}
	}
}
