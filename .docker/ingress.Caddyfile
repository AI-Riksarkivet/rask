# Local compose ingress — single origin for the SPA + API, mirroring the
# production topology where an ingress serves the frontend at / and proxies
# /api/* to the gateway. Without this, the SSR frontend (same-origin /api calls)
# has nowhere to send them: the gateway only owns /api, not /.
:80 {
	handle /api/* {
		reverse_proxy gateway:8888
	}
	handle {
		reverse_proxy frontend:3000
	}
}
