# The CloudNativePG operator: a prerequisite a platform runs once per cluster (ADR 0153). rask renders a CNPG `Cluster`
# only on the AGE-on-CNPG path (`age.cnpgCluster.enabled`), and only for a cluster that serves postgresql.cnpg.io/v1.
# Its CRDs are applied out of band from chart/crds-bootstrap/ (`make k3s-crds`, before this fixture), so no release owns
# them and no upgrade or uninstall deletes them or any Cluster.
RELEASE=cloudnative-pg
NAMESPACE=cnpg-system
REPO=https://cloudnative-pg.github.io/charts
CHART=cloudnative-pg
VERSION=0.28.3
