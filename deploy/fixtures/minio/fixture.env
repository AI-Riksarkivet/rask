# The development object store: a MinIO server (rask's first-party `minio` image) under the names rask's chart dials,
# Service `rask-minio:9000`, and the claims `data-<n>-rask-minio-<i>` the lakehouse's bytes live on. A platform runs its
# own S3 and rask names it (`minio.externalEndpoint`); rask's `minio.enabled` says this estate uses this one.
# Its root credential is `rask-infra-credentials`, which ESO writes from rask's dev store, so on an empty cluster the
# server starts once rask is installed: the install does not wait for it.
RELEASE=minio
NAMESPACE=default
# rask's own namespace, so it is not labelled as a fixture's.
SHARED_NAMESPACE=true
CHART=chart
WAIT=false
