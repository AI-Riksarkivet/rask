# The console's own release ([[XC-192]]): the console single-page app (the `web-console` image, a static-file server)
# and the notifications inbox (the `notifications` image), both clients of the lakehouse. The product chart renders
# neither; this release runs them beside a rask release in that release's namespace and reaches rask by reference only:
# the Gateway its routes attach to, Dex, the catalog's decision door, lineage's feed, the bus, the secret store and the
# OTel Collector. The inbox keeps its actor state on a Postgres this release renders, and generates its own Dapr app
# token. What the lakehouse must admit for it (its estate roles, its bus user, its secret-store reads) is supplied from
# `lakehouse-values.yaml` beside this file, which `make k3s-up` layers onto the lakehouse release. Its pods start once
# rask's doors answer, so the install does not wait for them.
RELEASE=console
NAMESPACE=default
# rask's own namespace: the inbox's sidecar loads rask's secret store Component and the bus by their in-namespace names.
SHARED_NAMESPACE=true
CHART=chart
WAIT=false
