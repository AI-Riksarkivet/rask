# The development secret store: an in-memory OpenBao dev server under the name rask's chart dials, `rask-openbao:8200`,
# with the seed beside it that writes rask's dev credentials, signing keys and bus trust root into it. A platform runs
# its own store and rask names it (`openbao.externalAddr`); rask's `openbao.enabled` says this estate uses
# this one. What to seed is rask's: the seed runs the scripts rask's chart renders into `rask-openbao-seed`, from the
# credentials ESO generates into `rask-dev-credentials`, so on an empty cluster the store starts once rask is installed.
RELEASE=openbao
NAMESPACE=default
# rask's own namespace, so it is not labelled as a fixture's.
SHARED_NAMESPACE=true
CHART=chart
WAIT=false
