# The development secret store: an in-memory OpenBao under the name rask's chart dials, `rask-openbao:8200`, with the seed
# beside it that initializes it and writes rask's dev credentials, signing keys, bus trust root, roles and policies into it.
# Its administrator token is generated in-cluster (`rask-openbao-root`, ESO's Password generator), so ESO comes first. A platform runs
# its own store and rask names it (`openbao.externalAddr`); rask's `openbao.enabled` says this estate uses
# this one. What to seed is rask's: the seed runs the scripts rask's chart renders into `rask-openbao-seed` and applies
# the roles and policies it renders into `rask-secret-store-identities`, from the credentials ESO generates into
# `rask-dev-credentials`, so on an empty cluster the store starts once rask is installed.
RELEASE=openbao
NAMESPACE=default
# rask's own namespace, so it is not labelled as a fixture's.
SHARED_NAMESPACE=true
CHART=chart
WAIT=false
