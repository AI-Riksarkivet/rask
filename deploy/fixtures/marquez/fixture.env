# The development graph backend: Marquez, the OpenLineage reference consumer, with its own Postgres. The lineage graph
# is bring-your-own (ADR 0158): rask's lineage forwards every event it records to the backend `services.lineage.forward`
# names, which deploy/values-local.yaml points here, as a platform's own graph backend would take them. In rask's
# namespace, Service `rask-marquez`.
RELEASE=marquez
NAMESPACE=default
# rask's own namespace, so it is not labelled as a fixture's.
SHARED_NAMESPACE=true
CHART=chart
