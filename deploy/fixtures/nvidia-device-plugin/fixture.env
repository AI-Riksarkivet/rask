# The NVIDIA device plugin, for a GPU node: it advertises nvidia.com/gpu, which a Ray head asking for `ray.gpuCount` > 0
# GPUs needs. A cluster that runs the NVIDIA GPU Operator or a cloud provider's plugin does not install this.
RELEASE=nvidia-device-plugin
NAMESPACE=nvidia-device-plugin
REPO=https://nvidia.github.io/k8s-device-plugin
CHART=nvidia-device-plugin
VERSION=0.19.3
