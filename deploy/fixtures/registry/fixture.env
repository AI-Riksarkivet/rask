# The development image registry ([[XC-202]]): where Dagger pushes the estate's builds (`172.17.0.1:5000`, the host from the
# engine's container) and k3s pulls them (`localhost:5000`, registries.yaml), served by a pod on the node's port 5000. A
# platform runs its own registry; this one is installed once per host by `make dev-registry`, not with the other
# fixtures, because a lane's own cluster runs a registry of its session instead.
RELEASE=registry
NAMESPACE=dev-registry
CHART=chart
