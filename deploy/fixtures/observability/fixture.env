# The observability chain a platform team runs (ADR 0153): GreptimeDB (the OTLP store, PromQL and SQL), Perses (rask's
# dashboards), vmalert (evaluates deploy/alerting/rules.yml) and Alertmanager. rask's Collector exports to it at
# http://greptimedb.observability:4000/v1/otlp, the `observability.export.endpoint` deploy/values-local.yaml names.
RELEASE=observability
NAMESPACE=observability
CHART=chart
# The alerting rules are an artefact of their own, outside every chart; the fixture's vmalert loads them.
SET_FILES="alerting.rules=deploy/alerting/rules.yml"
