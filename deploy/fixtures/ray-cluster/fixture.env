# A standing Ray cluster, in the rask release's namespace, that the compute fixture and the Serve consumers name
# (ray.dashboardUrl). Needs the kuberay-operator fixture first. Its head reaches rask by names a release called `rask`
# creates: the lineage and OTel endpoints.
RELEASE=ray-cluster
NAMESPACE=default
# rask's own namespace, so it is not labelled as a fixture's.
SHARED_NAMESPACE=true
CHART=chart
