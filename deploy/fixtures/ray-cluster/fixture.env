# A standing Ray cluster for rask's Ray engine adapter to submit to (ray.dashboardUrl), in the rask release's namespace.
# Needs the kuberay-operator fixture first. Its head runs rask's job scripts (the ray-cluster image) and reaches rask by
# names a release called `rask` creates: the lineage and OTel endpoints, the object store and its credential secret.
RELEASE=ray-cluster
NAMESPACE=default
# rask's own namespace, so it is not labelled as a fixture's.
SHARED_NAMESPACE=true
CHART=chart
