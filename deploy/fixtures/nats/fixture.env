# The NATS JetStream bus rask's pub/sub components and stream Job connect to: a prerequisite a platform runs
# (ADR 0153), named in rask's `nats.url`. In rask's namespace, because in operator mode the server reads its config
# from a Secret written from rask's dev OpenBao, and a pod mounts only Secrets of its own namespace.
RELEASE=nats
NAMESPACE=default
# rask's own namespace, so it is not labelled as a fixture's.
SHARED_NAMESPACE=true
CHART=chart
