# The dev OIDC issuer: Dex with in-memory storage, static users, the sign-in client and the lakehouse's audience client. A
# platform runs its own IdP and rask names it (`auth.oidc.issuer`, `auth.oidc.clientId`, `auth.oidc.audience`); rask's `dex.enabled` says this estate uses this one, which
# a real deployment refuses. In rask's namespace under the Service name rask's `lance.dexHost` dials, `rask-dex`.
# `make k3s-fixtures` passes it the issuer and origin it passes rask (DEV_ISSUER, DEV_ORIGIN).
RELEASE=dex
NAMESPACE=default
# rask's own namespace, so it is not labelled as a fixture's.
SHARED_NAMESPACE=true
CHART=chart
