# The development object store: one RustFS server under the names rask's chart dials, Service `rask-rustfs:9000`, and
# the claim `data-rask-rustfs-0` the lakehouse's bytes live on. A platform runs its own S3 and rask names it
# (`objectStore.externalEndpoint`); rask's `objectStore.enabled` says this estate uses this one.
# Its root credential is `rask-object-store-root`, which ESO writes from rask's dev store, so on an empty cluster the
# server starts once rask is installed: the install does not wait for it.
RELEASE=rustfs
NAMESPACE=default
# rask's own namespace, so it is not labelled as a fixture's.
SHARED_NAMESPACE=true
CHART=chart
WAIT=false
