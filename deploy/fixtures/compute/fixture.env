# The compute service (services/compute, the `compute` image): Ray dashboard introspection behind /api/ray and the
# /api/serve proxy, and the cron that prunes terminal Ray jobs. It is the companion of a bring-your-own Ray engine, not
# part of the lakehouse, so the product chart renders none of it (ADR 0155); this release runs it beside a rask release
# in that release's namespace and reaches rask by the names a release called `rask` creates: the Dapr app token, the
# `lance-tracing` Dapr Configuration, the OIDC issuer, the catalog, the OTel Collector and the Ray auth token. Those exist
# once rask is installed, so the install does not wait for the pod. rask's catalog answers its authorization questions
# only when rask's `auth.externalDeciders` names `<namespace>:<rask>-sa-compute` (deploy/values-local.yaml does).
RELEASE=compute
NAMESPACE=default
# rask's own namespace, so it is not labelled as a fixture's.
SHARED_NAMESPACE=true
CHART=chart
WAIT=false
