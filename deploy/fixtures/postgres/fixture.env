# The development Postgres: a stock PostgreSQL holding the one database OpenFGA keeps its store in. A Postgres is a
# platform service (ADR 0228): rask's chart runs none and names this one by address (`postgres.enabled`, Service
# `rask-postgres`), as it would the platform's (`postgres.externalHost`). In rask's namespace.
RELEASE=postgres
NAMESPACE=default
# rask's own namespace, so it is not labelled as a fixture's.
SHARED_NAMESPACE=true
CHART=chart
# Its password is the dev store's `postgres` secret, which rask's release seeds, so the pod is Ready only once rask is
# installed: the install does not wait for it.
WAIT=false
