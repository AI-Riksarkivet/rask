# The development Postgres: a stock PostgreSQL holding the catalog's database (ADR 0230) and the one OpenFGA keeps its
# store in. A Postgres is a platform service (ADR 0228): rask's chart runs none and names this one by address
# (`postgres.enabled`, Service `rask-postgres`), as it would the platform's (`postgres.externalHost`). In rask's namespace.
# The catalog's database and its three roles are made by the fixture's provisioning Job (`rask-postgres-provision-r<n>`,
# files/provision.sql), as the platform's DBA makes them in production: it runs on every install of this fixture and
# converges whatever the volume already holds, since the server's initdb scripts run only on an empty volume.
RELEASE=postgres
NAMESPACE=default
# rask's own namespace, so it is not labelled as a fixture's.
SHARED_NAMESPACE=true
CHART=chart
# Its password and the catalog's roles' are the dev store's secrets (`postgres`, `database-*`), which rask's release
# seeds, so the pod is Ready and the provisioning Job finishes only once rask is installed: the install does not wait.
WAIT=false
