# The annotator (services/annotator, the `annotator` image): a labeling tool that works on the lakehouse as any client
# does (ADR 0171). It reads and writes governed tables through the catalog's doors as the person on their own token,
# publishes as its own ServiceAccount, keeps its projects, tasks and roles in its own Dapr state store on a Postgres
# this release renders, and generates its own Dapr app token. The product chart renders none of it; this release runs
# it beside a rask release in that release's namespace and reaches rask by reference only: the catalog's address and
# the identity provider. Its pod starts once rask's catalog answers, so the install does not wait for it. A project
# admin grants its principal writer on a publish target through the catalog's grant door.
RELEASE=annotator
NAMESPACE=default
# rask's own namespace, so it is not labelled as a fixture's.
SHARED_NAMESPACE=true
CHART=chart
WAIT=false
