# The development SMTP relay: Mailpit, which keeps every message it is handed and serves them on its API, so a live
# read-back reads what the notifications inbox's email channel sent. The inbox is a client of the lakehouse that the
# console's own release deploys (ADR 0190); a platform runs its own relay. No default fixture list names it, so
# `make k3s-fixtures FIXTURES=mailpit` installs it. In rask's namespace,
# Service `rask-mailpit`: SMTP on 1025 with no authentication and no TLS, the API on 8025, the messages in memory.
RELEASE=mailpit
NAMESPACE=default
# rask's own namespace, so it is not labelled as a fixture's.
SHARED_NAMESPACE=true
CHART=chart
