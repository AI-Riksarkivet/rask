# The table-maintenance job (services/table-maintenance, the `table-maintenance` image): a bring-your-own CronJob that
# compacts each table rask's catalog lists as due that it may maintain, every commit judged at the catalog's
# version/create (ADR 0162). The lakehouse builds nothing, so the product chart renders none of it; this release runs it
# beside a rask release in that release's namespace and reaches rask by the catalog's address alone. Its ServiceAccount
# maintains the provenance namespace once rask's `services.lineage.provenanceMaintainers` names
# `<namespace>:<rask>-sa-table-maintenance` (deploy/values-local.yaml does), and any table its owner grants it
# `maintainer` on.
RELEASE=table-maintenance
NAMESPACE=default
# rask's own namespace, so it is not labelled as a fixture's.
SHARED_NAMESPACE=true
CHART=chart
WAIT=false
