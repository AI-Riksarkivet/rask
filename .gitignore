__pycache__/
*.pyc
.coverage
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/
# uv / virtualenvs — `.venv/` matches at ANY depth (root + any stray nested .venv)
.venv/
**/.venv/
.uv/
uv-cache/
.python-version-local
.env

# JS / SvelteKit
node_modules/
.svelte-kit/
storybook-static/

# Zensical docs build output
site/

# Local SQLite catalog + manifest dump (built by scripts/{build,sync,count}_*.py)
.cache/
batches.db
scripts/batch_ids.txt

# Demo runtime endpoints (machine-specific). `make medallion-demo` no longer writes this —
# the driver runs inside the Dagger service and reads its endpoints from the environment — but a
# hand-run `python scripts/medallion_demo.py` against your own stack still can.
.medallion-demo.env

.localbin/

# playwright-cli skill scratch logs (tool artifacts, not source)
.playwright-cli/
test-results/

# Turborepo
.turbo

# vendored helm subcharts — rebuilt via `make k3s-deps` (helm dependency build) from Chart.lock
chart/charts/

# superpowers SDD scratch (ledger, briefs)
.superpowers/

# git worktrees created by tooling — a second checkout, never content of this one
.claude/worktrees/

/api/

# Local ingest-lane run ids — written by scripts/ingest-lane.sh, consumed by the A20 e2e.
# A run id from one operator's cluster means nothing in anyone else's, and it changes on
# every lane run, so tracking it makes every verification show up as a source change.
.a11-run-id
.a5-run-id
