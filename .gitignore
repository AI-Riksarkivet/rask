.venv/
**/.venv/
.uv/
uv-cache/
.python-version-local
.env

# JS / SvelteKit
node_modules/
.svelte-kit/
storybook-static/

# Zensical docs build output
site/

# Local SQLite catalog + manifest dump (built by scripts/{build,sync,count}_*.py)
.cache/
batches.db
scripts/batch_ids.txt

# Demo runtime endpoints (written by scripts/medallion_demo.sh; machine-specific)
.medallion-demo.env

# Locally-downloaded cluster tooling (kind/kubectl/k9s/tilt) — not committed
.localbin/

# playwright-cli skill scratch logs (tool artifacts, not source)
.playwright-cli/
test-results/

# Turborepo
.turbo

# vendored helm subcharts — rebuilt via `make k3s-deps` (helm dependency build) from Chart.lock
chart/charts/

# superpowers SDD scratch (ledger, briefs)
.superpowers/

# git worktrees created by tooling — a second checkout, never content of this one
.claude/worktrees/

# Tilt editor stubs (`tilt dump api-docs`) — dropped at the repo root by the Tilt VS Code extension
/api/
