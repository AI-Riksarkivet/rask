{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; [ -n \"$f\" ] && [ -f \"$f\" ] && prek run --files \"$f\" >/dev/null 2>&1 || true; }"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "mcp-essentials@claude-code-toolkit": true,
    "analytics@claude-code-toolkit": true,
    "toolkit-skills@claude-code-toolkit": true,
    "deno-skills@denoland-skills": true,
    "redis-development@redis": true,
    "svelte@svelte": true,
    "astral@astral-sh": true,
    "svelte-flow@linehaulai-claude-marketplace": true,
    "svelte-skills@svelte-skills-kit": true
  }
}
