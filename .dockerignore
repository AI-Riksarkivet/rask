# rask .dockerignore
# Install: cp .claude/skills/dockerfile/templates/dockerignore .dockerignore
# Single source of truth for ALL .docker/*.dockerfile builds (build context = repo root).
# BuildKit only reads <context-root>/.dockerignore — a file under .docker/ is silently ignored.

# VCS
.git
.gitignore
.gitattributes

# CI / docker / build orchestration (in the source tree, but never inside the image)
.docker/
.dagger/
Dockerfile
*.dockerfile
.dockerignore
# …except the build-time gates, which by definition have to be IN the build. The import gate is
# COPYd to /tmp and removed by the RUN that executes it, so the shipped filesystem lacks it while its
# COPY layer still holds it; the pool gate is bind-mounted into the RUN that executes it, so no layer
# holds it. The rule above is about what the IMAGE carries, and these are the files that must cross
# the context boundary to enforce it. The negations must FOLLOW `.docker/` — .dockerignore is
# last-match-wins, and placed above it a pattern is silently overridden with no error anywhere.
!.docker/import-gate.py
!.docker/pool-gate.py

# Local k8s tooling (downloaded binaries) + cluster state
.localbin/

# Python venvs and caches
.venv
.venv*/
**/.venv/
**/__pycache__
**/*.pyc
**/*.pyo
*.egg-info/
*.dist-info/
.mypy_cache
.ruff_cache
.pytest_cache

# JS/TS build artefacts and caches (frontend/ is built inside the image). Use **/ so nested copies
# like frontend/microfrontends/*/node_modules are excluded too — a bare `node_modules` only matches
# the context root, which would let host node_modules ship and overwrite the clean `bun install`.
**/node_modules
dist
build
**/.svelte-kit
# Turborepo's per-package task cache. NOT excluded until 2026-07-29, and it is rewritten by every
# `turbo run` — so the frontend build context changed after any local lint/check/test, invalidating the
# directories, none of them wanted in an image.
**/.turbo
storybook-static
test-results

# Test/coverage outputs
coverage/
htmlcov/
.coverage
.coverage.*

# Editor / IDE / OS junk
.idea/
.vscode/
.cursor*
.DS_Store
*.swp
*.swo

# Infra-as-code state
.terraform/
.terraform.lock.hcl

# Secrets and local config
.env
.env.*
.secret
.secret.*

# Claude Code project state
.claude/

# Logs
*.log
logs/

# Model weights (large; should never be in build context — mount at runtime)
**/weights/
**/*.pt
**/*.bin
**/*.safetensors
