{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		"components/frontends/*": {
			"entry": ["src/**/*.remote.ts", "src/**/*.server.ts"]
		},
		"components/frontends/home": {
			"entry": ["src/**/*.remote.ts", "src/**/*.server.ts"]
		},
		"packages/ui": {
			"entry": ["src/lib/**/index.{ts,js}"],
			"project": ["src/**/*.{ts,js,svelte}"]
		},
		"tests/e2e": {
			"entry": ["playwright.config.ts", "tests/**/*.spec.ts"]
		}
	}
}
