{
	"name": "annotator",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "svelte-kit sync",
		"dev": "vite dev",
		"build": "vite build",
		"start": "bun ./build/index.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"lint": "oxlint .",
		"fmt": "rsvelte-fmt .",
		"fmt:check": "rsvelte-fmt --check ."
	},
	"dependencies": {
		"@lucide/svelte": "^1.26.0",
		"@rask/api": "workspace:*",
		"@rask/engine": "workspace:*",
		"@rask/labeling": "workspace:*",
		"@rask/explorer-api": "workspace:*",
		"@rask/ui": "workspace:*",
		"apache-arrow": "^21.2.0",
		"mode-watcher": "^1.1.0",
		"pixi.js": "^8.19.0",
		"svelte": "^5.56.8",
		"svelte-sonner": "^1.1.1",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.0",
		"@rask/config": "workspace:*",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.3.14",
		"@webgpu/types": "^0.1.71",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	}
}
