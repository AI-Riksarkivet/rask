{
	"name": "console",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "svelte-kit sync",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "bun ./serve.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run --dir src",
		"test:e2e": "vite build && playwright test",
		"lint": "oxlint .",
		"fmt": "rsvelte-fmt .",
		"fmt:check": "rsvelte-fmt --check ."
	},
	"dependencies": {
		"@lucide/svelte": "^1.26.0",
		"@rask/api": "workspace:*",
		"@rask/dockview": "workspace:*",
		"@rask/flow": "workspace:*",
		"@rask/ui": "workspace:*",
		"@sveltejs/kit": "^2.70.1",
		"@tailwindcss/vite": "^4.3.3",
		"@xyflow/svelte": "^1.6.2",
		"apache-arrow": "^21.2.0",
		"dockview": "^7.0.4",
		"gsap": "^3.15.0",
		"mode-watcher": "^1.1.0",
		"oidc-client-ts": "^3.5.0",
		"svelte-sonner": "^1.1.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/bun": "^1.3.14",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.3",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	}
}
