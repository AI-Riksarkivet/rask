{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignoreExportsUsedInFile": {
		"type": true,
		"interface": true
	},
	"ignoreIssues": {
		"console/tsconfig.json": ["unlisted"],
		"console/src/lib/api/generated/**": ["types"]
	},
	"ignoreBinaries": [
		"make"
	],
	"workspaces": {
		"console": {
			"entry": [
				"serve.ts",
				"e2e/edge.ts",
				"e2e/mock-*.ts",
				"e2e/*/mock-*.ts"
			]
		},
		"packages/ui": {
			"entry": [
				"src/lib/**/index.{ts,js}"
			],
			"project": [
				"src/**/*.{ts,js,svelte}"
			]
		}
	}
}
