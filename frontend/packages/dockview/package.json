{
	"name": "@rask/dockview",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./styles.css": "./src/styles.css"
	},
	"scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json",
