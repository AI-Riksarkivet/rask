{
	"name": "@rask/engine",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./*": "./src/*"
	},
	"scripts": {
		"check": "bunx tsc --noEmit",
		"check:tsgo": "tsgo --noEmit -p tsconfig.json",
		"test": "vitest run",
