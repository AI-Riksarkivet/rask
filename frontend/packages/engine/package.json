		"fmt": "rsvelte-fmt .",
		"fmt:check": "rsvelte-fmt --check ."
	},
	"dependencies": {
		"apache-arrow": "^21.2.0",
		"flatbush": "^4.6.2",
		"pixi.js": "^8.19.0",
		"wavesurfer.js": "^7.12.11"
	},
	"devDependencies": {
		"@rask/config": "workspace:*",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	}
}
