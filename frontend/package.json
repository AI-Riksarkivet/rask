{
	"name": "rask-frontend",
	"private": true,
	"license": "Apache-2.0",
	"packageManager": "bun@1.4.4",
	"workspaces": [
		"console",
		"packages/*"
	],
	"scripts": {
		"build": "bun --cwd=packages/ui run build && bun --cwd=console run build",
		"build-storybook": "bun --cwd=packages/ui run build-storybook",
		"check": "bun run build && bun run --filter '*' check",
		"dev": "bun --cwd=packages/ui run build && bun --cwd=console run dev",
		"fmt": "bun run --filter '*' fmt",
		"fmt:check": "bun run --filter '*' fmt:check",
		"gen:types": "bun run gen:types:lineage && bun run gen:types:catalog",
		"gen:types:catalog": "openapi-typescript ../docs/catalog-openapi.json --default-non-nullable false -o packages/api/src/generated/catalog.ts",
		"gen:types:lineage": "openapi-typescript ../docs/lineage-openapi.json --default-non-nullable false -o packages/api/src/generated/lineage.ts",
		"knip": "knip --no-config-hints",
		"lint": "bun run --filter '*' lint",
		"storybook": "bun --cwd=packages/ui run storybook",
		"test": "bun run build && bun run --filter '*' test",
		"test:e2e": "bun --cwd=packages/ui run build && bun --cwd=console run test:e2e"
	},
	"devDependencies": {
		"@rsvelte/fmt": "^0.7.12",
		"@rsvelte/oxlint-plugin": "^0.2.3",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"knip": "^6.44.1",
		"openapi-typescript": "^7.13.0",
		"oxfmt": "^0.64.0",
		"oxlint": "^1.79.0",
		"typescript": "^6.0.3"
	},
	"patchedDependencies": {
		"bits-ui@2.18.1": "patches/bits-ui@2.18.1.patch",
		"apache-arrow@21.2.0": "patches/apache-arrow@21.2.0.patch"
	},
	"overrides": {
		"svelte": "5.57.3",
		"brace-expansion": "^2.1.7",
		"devalue": "^5.9.4",
		"js-yaml": "^4.3.2",
		"nanoid": "^3.3.20",
		"postcss": "^8.5.32",
		"source-map-js": "^1.2.2",
		"tinypool": "^2.2.0"
	}
}
