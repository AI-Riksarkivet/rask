// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "opencode": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "ssh_connections": [
    {
      "host": "10.16.51.53",
      "username": "blackwell",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/blackwell"
          ]
        },
        {
          "paths": [
            "/home/blackwell/Desktop/./"
          ]
        },
        {
          "paths": [
            "/home/blackwell/Desktop/diffu/./"
          ]
        },
        {
          "paths": [
            "/home/blackwell/Desktop/rask"
          ]
        }
      ],
      // Zed does not forward ports automatically over SSH — each one must be
      // declared here. local_port 8080 -> remote 80 because binding a
      // privileged port locally needs admin.
      "port_forwards": [
        // the app + tooling UIs
        { "local_port": 8080, "remote_port": 80 },  // k3s traefik ingress — THE app UI
        { "local_port": 3024, "remote_port": 3024 },  // microfrontends composing proxy
        { "local_port": 8888, "remote_port": 8888 },  // gateway API (/api/*)
        { "local_port": 6006, "remote_port": 6006 },  // Storybook (@rask/ui)
        { "local_port": 8265, "remote_port": 8265 },  // Ray dashboard
        // fleet services
        { "local_port": 8804, "remote_port": 8804 },  // compute (/api/ray, /api/serve)
        { "local_port": 8820, "remote_port": 8820 },  // controlplane (/api/projects)
        { "local_port": 8101, "remote_port": 8101 },  // media viewer
        { "local_port": 5000, "remote_port": 5000 },  // dev image registry
        // SvelteKit zone dev servers (make dev-frontends)
        { "local_port": 5173, "remote_port": 5173 },
        { "local_port": 5174, "remote_port": 5174 },
        { "local_port": 5175, "remote_port": 5175 },
        { "local_port": 5176, "remote_port": 5176 },
        { "local_port": 5177, "remote_port": 5177 },
        { "local_port": 5178, "remote_port": 5178 },
        { "local_port": 5179, "remote_port": 5179 },
        { "local_port": 5180, "remote_port": 5180 },
        { "local_port": 5273, "remote_port": 5273 },
        { "local_port": 5274, "remote_port": 5274 },
        { "local_port": 5275, "remote_port": 5275 },
        { "local_port": 5276, "remote_port": 5276 },
        { "local_port": 5277, "remote_port": 5277 },
        { "local_port": 5278, "remote_port": 5278 },
        { "local_port": 5279, "remote_port": 5279 },
        { "local_port": 5280, "remote_port": 5280 },
        // kind-browse port-forwards
        { "local_port": 9273, "remote_port": 9273 },
        { "local_port": 9274, "remote_port": 9274 },
        { "local_port": 9275, "remote_port": 9275 },
        { "local_port": 9276, "remote_port": 9276 },
        { "local_port": 9277, "remote_port": 9277 },
        { "local_port": 9278, "remote_port": 9278 },
        { "local_port": 9279, "remote_port": 9279 },
        { "local_port": 9888, "remote_port": 9888 },  // gateway
      ]
    }
  ],
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Mocha",
    "dark": "Catppuccin Mocha"
  },
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "sandbox_permissions": {
      "network_hosts": [
        "pypi.org"
      ]
    },
    "tool_permissions": {
      "tools": {
        "skill": {
          "default": "allow"
        },
        "fetch": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow"
        }
      }
    },
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-5",
      "enable_thinking": true,
      "effort": "max"
    },
    "dock": "left",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark"
  }
}
