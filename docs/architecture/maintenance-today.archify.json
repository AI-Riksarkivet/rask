  "cards": [
    {
      "dot": "cyan",
      "title": "Three triggers, one planner",
      "items": [
        "Arrival on lineage.events.v1 is the primary trigger",
        "The sweep cron is the backstop for tables nobody wrote",
        "Reconcile has its own binding, so the cheap read never rides the expensive write"
      ]
    },
    {
      "dot": "emerald",
      "title": "The queue lane",
      "items": [
        "The planner publishes and does not consume: MAINTENANCE_EXECUTE_WORK=false",
        "WORK retention \u2014 an acked unit leaves the stream, so the 2 replicas compete",
        "Exhausted deliveries park on the DLQ instead of looping"
      ]
    },
    {
      "dot": "amber",
      "title": "What actually executes",
      "items": [
        "execute_unit: compaction, index optimize, old-version cleanup via pylance",
        "DISTRIBUTED_COMPACTION=true moves only PLAN and COMMIT to the catalog",
        "The rewrite itself stays a for-loop over tasks in one process"
      ]
    },
    {
      "dot": "rose",
      "title": "Not here yet",
      "items": [
        "No Dapr Workflow and no Ray anywhere in services/maintenance",
        "The target is named in the docstring: lance-ray compact_database",
        "Live now: one 512Mi pod, no worker Deployment, no work topic set"
      ]
    }
  ]
